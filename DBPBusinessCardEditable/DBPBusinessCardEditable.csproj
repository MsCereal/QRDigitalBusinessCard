<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>92abba99-2f8a-47be-bb28-4571e4d056dc</UserSecretsId>
  </PropertyGroup>

  <!-- Never ship local developer settings (AD service account password, local paths) or build logs -->
  <ItemGroup>
    <Content Update="appsettings.Local.json" CopyToPublishDirectory="Never" />
    <Content Update="appsettings.Local.json.example" CopyToPublishDirectory="Never" />
    <Content Update="build-*.txt" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.2.0" />
    <PackageReference Include="Dapper" Version="2.1.89" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Negotiate" Version="8.0.34" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.34" />
    <PackageReference Include="QRCoder" Version="1.8.1" />
    <PackageReference Include="SkiaSharp" Version="4.155.0" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="4.155.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.3.1" />
  </ItemGroup>

  <!-- SkiaSharp ships ~100 MB debug-symbol files (.pdb) for its native library; servers don't need them -->
  <Target Name="RemoveNativeDebugSymbols" AfterTargets="Publish">
    <ItemGroup>
      <_NativePdb Include="$(PublishDir)runtimes\**\*.pdb;$(PublishDir)libSkiaSharp.pdb" />
    </ItemGroup>
    <Delete Files="@(_NativePdb)" />
  </Target>

</Project>
