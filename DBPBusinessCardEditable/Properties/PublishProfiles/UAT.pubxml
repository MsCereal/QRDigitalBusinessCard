<?xml version="1.0" encoding="utf-8"?>
<!--
  UAT publish profile (Windows server, IIS).
  Visual Studio: right-click the project > Publish > choose "UAT" > Publish.
  Command line:  dotnet publish -c Release /p:PublishProfile=UAT
  Output folder: QR_DBP\publish_output\UAT   (gitignored)
-->
<Project>
  <PropertyGroup>
    <WebPublishMethod>FileSystem</WebPublishMethod>
    <PublishProvider>FileSystem</PublishProvider>
    <Configuration>Release</Configuration>
    <LastUsedBuildConfiguration>Release</LastUsedBuildConfiguration>
    <TargetFramework>net8.0</TargetFramework>
    <!-- Windows 64-bit only: no Linux/Mac/ARM native files in the package -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- Uses the .NET 8 ASP.NET Core Hosting Bundle installed on the server -->
    <SelfContained>false</SelfContained>
    <PublishUrl>..\publish_output\UAT\</PublishUrl>
    <!-- Same folder when publishing from the command line -->
    <PublishDir>..\publish_output\UAT\</PublishDir>
    <DeleteExistingFiles>true</DeleteExistingFiles>
    <ExcludeApp_Data>false</ExcludeApp_Data>
  </PropertyGroup>
</Project>
