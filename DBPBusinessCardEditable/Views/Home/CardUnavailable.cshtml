@model DBPBusinessCardEditable.Models.CardProfile
@{ Layout = null; }
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Card Unavailable</title>
    <link rel="icon" type="image/png" href="/dbp-icon.png" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
        body { font-family: Arial, sans-serif; min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 20px; position: relative; }
        .bg { position: fixed; inset: 0; z-index: 0; background: linear-gradient(155deg, rgba(10,25,70,0.95) 0%, rgba(30,64,175,0.90) 45%, rgba(15,40,100,0.97) 100%), url('/bg.png') center/cover no-repeat; }
        .card { position: relative; z-index: 1; background: #fff; border-radius: 20px; padding: 40px 28px; max-width: 360px; width: 100%; text-align: center; box-shadow: 0 16px 48px rgba(0,0,0,0.35); }
        .icon { font-size: 48px; color: #94a3b8; margin-bottom: 16px; }
        img.logo { width: 56px; height: 56px; object-fit: contain; margin-bottom: 16px; display: block; margin-left: auto; margin-right: auto; }
        h1 { color: #0f172a; font-size: 20px; font-weight: 800; margin-bottom: 8px; }
        p  { color: #64748b; font-size: 13px; margin-bottom: 24px; }
        .divider { height: 1px; background: #f1f5f9; margin: 20px 0; }
        .btn { display: flex; align-items: center; justify-content: center; gap: 8px; padding: 13px; border-radius: 11px; background: linear-gradient(135deg, #2563eb, #1d4ed8); color: #fff; font-size: 14px; font-weight: 700; text-decoration: none; box-shadow: 0 4px 14px rgba(37,99,235,0.3); }
    </style>
</head>
<body>
<div class="bg"></div>
<div class="card">
    <img src="/dbp-logo.png" alt="DBP" class="logo" />
    <div class="icon"><i class="fa-solid fa-circle-pause"></i></div>
    <h1>Card Unavailable</h1>
    <p>This digital business card is currently inactive. Please contact the cardholder directly.</p>
    <div class="divider"></div>
    <a href="/" class="btn"><i class="fa-solid fa-house"></i> Back to Home</a>
</div>
</body>
</html>
