               maxlength="6" inputmode="numeric" autocomplete="off"
               style="width:100%;padding:12px 14px;border:1.5px solid #e5e7eb;border-radius:10px;font-size:16px;color:#0f172a;background:#f9fafb;outline:none;text-align:center;letter-spacing:3px;margin-bottom:16px;"
