                        var allLabels2 = new[]{"Facebook","Instagram","Twitter / X","TikTok","YouTube","Messenger","WhatsApp","Viber","Telegram","Skype","Discord","Snapchat","Department","Birthday","Other"};
                        var labelIcons2 = new System.Collections.Generic.Dictionary<string,string>{{"Facebook","📘"},{"Instagram","📷"},{"Twitter / X","🐦"},{"TikTok","🎵"},{"YouTube","▶️"},{"Messenger","💬"},{"WhatsApp","📱"},{"Viber","📳"},{"Telegram","✈️"},{"Skype","🔵"},{"Discord","🎮"},{"Snapchat","👻"},{"Department","🏢"},{"Birthday","🎂"},{"Other","✏️"}};
                        var currentLabel2 = Model.ExtraInfo[i].Label;
                        var selectHtml2 = new System.Text.StringBuilder();
                        selectHtml2.Append($"<select class=\"extra-select\" name=\"ExtraInfo[{i}].Label\">");
                        foreach (var opt in allLabels2) {
                            var sel = opt == currentLabel2 ? " selected" : "";
                            selectHtml2.Append($"<option value=\"{opt}\"{sel}>{labelIcons2[opt]} {opt}</option>");
                        }
                        selectHtml2.Append("</select>");
                        <div class="extra-row">
                            <div class="extra-row-top">
                                @Html.Raw(selectHtml2.ToString())
                                <input type="text" class="extra-value-input" name="ExtraInfo[@i].Value" value="@Model.ExtraInfo[i].Value" placeholder="Username, URL or number" maxlength="200" />
                                <button type="button" class="extra-remove-btn" onclick="removeExtraRow(this)"><i class="fa-solid fa-xmark"></i></button>
