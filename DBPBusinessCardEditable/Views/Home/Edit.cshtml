@model DBPBusinessCardEditable.Models.CardProfile
@{
    Layout = null;
    bool isExisting = !string.IsNullOrWhiteSpace(Model?.CardToken);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>DBP - Card Setup</title>
    <link rel="icon" type="image/png" href="/dbp-icon.png" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
        body { font-family: Arial, sans-serif; min-height: 100vh; display: block; position: relative; overflow-x: hidden; }
        /* Form always centered */
        .wrap { width: 100%; max-width: 440px; margin: 0 auto; }
        .bg { position: fixed; inset: 0; z-index: -1; background: linear-gradient(155deg, rgba(10,25,70,0.92) 0%, rgba(30,64,175,0.88) 45%, rgba(15,40,100,0.95) 100%), url('/bg.png') center/cover no-repeat; }
        .preview-label {
            color: rgba(255,255,255,0.45); font-size: 10px; font-weight: 700;
            letter-spacing: 2px; text-transform: uppercase; margin-bottom: 10px;
            text-align: center;
        }
        .preview-card {
            background: #fff; border-radius: 16px;
            box-shadow: 0 12px 36px rgba(0,0,0,0.3);
            padding: 20px 16px 22px; text-align: center;
            border-top: 4px solid #2563eb;
        }
        .preview-photo-wrap { margin-bottom: 10px; }
        .preview-photo {
            width: 64px; height: 64px; border-radius: 50%;
            object-fit: cover; border: 2px solid #e5e7eb;
            display: block; margin: 0 auto;
        }
        .preview-avatar {
            width: 64px; height: 64px; border-radius: 50%;
            background: #eff6ff; border: 2px solid #bfdbfe;
            display: flex; align-items: center; justify-content: center;
            margin: 0 auto; overflow: hidden;
        }
        .preview-avatar img { width: 100%; height: 100%; object-fit: cover; }
        .preview-avatar i { font-size: 26px; color: #93c5fd; }
        .preview-name { color: #0f172a; font-size: 15px; font-weight: 800; margin-bottom: 2px; word-break: break-word; }
        .preview-title { color: #334155; font-size: 11px; font-weight: 500; margin-bottom: 1px; }
        .preview-dept  { color: #64748b; font-size: 11px; margin-bottom: 1px; }
        .preview-org   { color: #94a3b8; font-size: 11px; }
        .preview-divider { height: 1px; background: #f1f5f9; margin: 10px 0; }
        .preview-badge {
            display: inline-block; background: #eff6ff; border: 1px solid #bfdbfe;
            color: #2563eb; font-size: 10px; font-weight: 700; padding: 2px 10px;
            border-radius: 20px; margin-bottom: 8px;
        }
        /* Floating preview button — always visible */
        .preview-fab {
            display: flex; position: fixed; bottom: 20px; right: 20px; z-index: 200;
            background: #2563eb; color: #fff; border: none; border-radius: 50px;
            padding: 10px 18px; font-size: 13px; font-weight: 700; cursor: pointer;
            box-shadow: 0 4px 16px rgba(37,99,235,0.5);
            align-items: center; gap: 7px;
        }
        .preview-modal-overlay {
            display: none; position: fixed; inset: 0; z-index: 300;
            background: rgba(0,0,0,0.6); backdrop-filter: blur(3px);
            align-items: flex-end; justify-content: center;
        }
        .preview-modal-overlay.open { display: flex; }
        .preview-modal {
            background: #0f172a; border-radius: 20px 20px 0 0;
            padding: 20px 20px 36px; width: 100%; max-width: 440px;
            animation: slideUp 0.25s ease;
        }
        @@keyframes slideUp { from { transform: translateY(100%); } to { transform: translateY(0); } }
        .preview-modal-header {
            display: flex; align-items: center; justify-content: space-between;
            margin-bottom: 14px;
        }
        .preview-modal-title { color: rgba(255,255,255,0.6); font-size: 11px; font-weight: 700; letter-spacing: 2px; text-transform: uppercase; }
        .preview-modal-close { background: none; border: none; color: rgba(255,255,255,0.5); font-size: 18px; cursor: pointer; }
        @@media (max-width: 480px) { .preview-fab { padding: 8px 14px; font-size: 12px; } }        .back { display: inline-flex; align-items: center; gap: 6px; color: rgba(255,255,255,0.5); font-size: 13px; text-decoration: none; margin-bottom: 16px; transition: color 0.15s; }
        .back:hover { color: rgba(255,255,255,0.85); }
        .card { background: #fff; border-radius: 20px; padding: 28px 24px; border-top: 5px solid #2563eb; box-shadow: 0 12px 40px rgba(0,0,0,0.25); }
        .photo-section { text-align: center; margin-bottom: 18px; }
        .photo-section-label { font-size: 10px; font-weight: 800; letter-spacing: 1.5px; text-transform: uppercase; color: #2563eb; margin-bottom: 10px; }
        .photo-top-wrap { position: relative; display: inline-block; margin-bottom: 6px; }
        .photo-top-circle { width: 96px; height: 96px; border-radius: 50%; border: 3px solid #e5e7eb; box-shadow: 0 4px 14px rgba(0,0,0,0.1); background: #f8fafc; overflow: hidden; display: flex; align-items: center; justify-content: center; }
        .photo-top-circle img { width: 100%; height: 100%; object-fit: cover; display: block; }
        .photo-top-circle i { font-size: 42px; color: #bfdbfe; }
        .camera-badge { position: absolute; top: 2px; right: -4px; width: 30px; height: 30px; border-radius: 50%; background: #2563eb; border: 2.5px solid #fff; display: flex; align-items: center; justify-content: center; box-shadow: 0 2px 8px rgba(37,99,235,0.4); cursor: pointer; transition: background 0.15s, transform 0.12s; }
        .camera-badge:hover { background: #1d4ed8; transform: scale(1.1); }
        .camera-badge i { font-size: 12px; color: #fff; }
        .photo-toggle-row { display: flex; align-items: center; justify-content: center; gap: 8px; margin-top: 8px; }
        .photo-sheet-overlay { display: none; position: fixed; inset: 0; z-index: 100; background: rgba(0,0,0,0.35); backdrop-filter: blur(2px); pointer-events: none; }
        .photo-sheet-overlay.open { display: flex; align-items: flex-end; justify-content: center; pointer-events: all; }
        .photo-sheet { background: #fff; border-radius: 20px 20px 0 0; padding: 20px 20px 32px; width: 100%; max-width: 440px; box-shadow: 0 -8px 30px rgba(0,0,0,0.2); animation: slideUp 0.25s ease; }
        @@keyframes slideUp { from { transform: translateY(100%); } to { transform: translateY(0); } }
        .photo-sheet-title { text-align: center; font-size: 11px; font-weight: 800; letter-spacing: 1.5px; text-transform: uppercase; color: #9ca3af; margin-bottom: 16px; }
        .photo-sheet-options { display: flex; flex-direction: column; gap: 10px; }
        .sheet-option { display: flex; align-items: center; gap: 14px; padding: 13px 16px; border: 1.5px solid #e5e7eb; border-radius: 12px; background: #fff; cursor: pointer; width: 100%; text-align: left; transition: border-color 0.15s, background 0.15s; }
        .sheet-option:hover { border-color: #2563eb; background: #eff6ff; }
        .sheet-option-icon { width: 40px; height: 40px; border-radius: 10px; background: #eff6ff; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
        .sheet-option-icon i { font-size: 17px; color: #2563eb; }
        .sheet-option-icon.male-icon { background: #dbeafe; }
        .sheet-option-icon.female-icon { background: #fce7f3; }
        .sheet-option-text { display: flex; flex-direction: column; gap: 1px; }
        .sheet-option-text strong { font-size: 14px; color: #111827; font-weight: 700; }
        .sheet-option-text span { font-size: 12px; color: #9ca3af; }
        .sheet-cancel { margin-top: 10px; width: 100%; padding: 13px; border: none; border-radius: 12px; background: #f3f4f6; color: #6b7280; font-size: 14px; font-weight: 700; cursor: pointer; }
        .sheet-cancel:hover { background: #e5e7eb; }
        h1 { text-align: center; color: #111827; font-size: 19px; font-weight: 800; margin-bottom: 3px; }
        .sub { text-align: center; color: #6b7280; font-size: 12px; }
        .divider { height: 1px; background: #e5e7eb; margin: 16px 0; }
        .section-title { font-size: 10px; font-weight: 800; letter-spacing: 1.5px; text-transform: uppercase; color: #2563eb; margin-bottom: 10px; }
        .form-group { margin-bottom: 12px; }
        .field-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 5px; }
        .field-header label { font-size: 11px; font-weight: 700; color: #374151; text-transform: uppercase; letter-spacing: 0.3px; margin-bottom: 0; }
        .toggle-wrap { display: flex; align-items: center; gap: 5px; flex-shrink: 0; }
        /* Eye-only toggle — no switch, just a clickable eye icon */
        .eye-toggle {
            font-size: 15px; line-height: 1; cursor: pointer; padding: 2px 4px;
            border-radius: 5px; transition: color 0.15s, background 0.15s;
            color: rgba(37,99,235,0.75);
            background: none; border: none; outline: none;
        }
        .eye-toggle.hidden { color: rgba(220,38,38,0.75); }
        .eye-toggle:hover { background: #f1f5f9; }
        input[type=text], input[type=tel], input[type=email], input[type=url], input[type=password] { width: 100%; padding: 10px 13px; border: 1.5px solid #e5e7eb; border-radius: 9px; font-size: 14px; color: #111827; background: #f9fafb; outline: none; transition: border-color 0.15s, background 0.15s, box-shadow 0.15s; }
        input[type=text]:focus, input[type=tel]:focus, input[type=email]:focus, input[type=url]:focus, input[type=password]:focus { border-color: #2563eb; background: #fff; box-shadow: 0 0 0 3px rgba(37,99,235,0.1); }
        input.empid { font-weight: 800; font-size: 15px; border-color: #2563eb; color: #1d4ed8; }
        input[readonly] { background: #eff6ff; color: #1d4ed8; cursor: default; }
        input.field-hidden { background: #fef2f2 !important; color: #fca5a5 !important; border-color: #fecaca !important; border-style: dashed !important; }
        .hint { font-size: 11px; color: #9ca3af; margin-top: 3px; }
        .hide-hint { font-size: 11px; color: #fca5a5; margin-top: 3px; font-style: italic; }
        .alert { padding: 10px 14px; border-radius: 9px; font-size: 13px; font-weight: 700; margin-bottom: 14px; text-align: center; }
        .alert-error { background: #fee2e2; color: #b91c1c; }
        .alert-info  { background: #dbeafe; color: #1d4ed8; }
        .alert-ad    { background: #ecfdf5; color: #065f46; border: 1px solid #a7f3d0; display: flex; align-items: flex-start; gap: 8px; text-align: left; font-weight: 600; }
        .ad-icon     { font-size: 16px; flex-shrink: 0; line-height: 1.4; }
        .btn { display: flex; align-items: center; justify-content: center; gap: 8px; width: 100%; padding: 13px 16px; border-radius: 11px; font-size: 15px; font-weight: 800; cursor: pointer; border: none; text-decoration: none; color: #fff; transition: transform 0.12s, box-shadow 0.12s; margin-bottom: 8px; }
        .btn:last-child { margin-bottom: 0; }
        .btn:active { transform: scale(0.97); }
        .btn-save { background: linear-gradient(135deg, #2563eb, #1d4ed8); box-shadow: 0 4px 14px rgba(37,99,235,0.35); }
        .btn-save:hover { box-shadow: 0 6px 20px rgba(37,99,235,0.45); }
        /* PIN error state */
        input.pin-error { border-color: #dc2626 !important; background: #fef2f2 !important; box-shadow: 0 0 0 3px rgba(220,38,38,0.15) !important; animation: shake 0.4s ease; }
        .pin-error-msg { font-size: 11px; color: #dc2626; font-weight: 700; margin-top: 4px; display: none; }
        .pin-error-msg.show { display: block; }
        @@keyframes shake {
            0%,100% { transform: translateX(0); }
            20%      { transform: translateX(-6px); }
            40%      { transform: translateX(6px); }
            60%      { transform: translateX(-4px); }
            80%      { transform: translateX(4px); }
        }
        .btn-danger { background: transparent; border: 1.5px solid #e5e7eb; color: #dc2626; font-size: 13px; padding: 10px; box-shadow: none; }
        .btn-danger:hover { background: #fee2e2; border-color: #fca5a5; }
        .extra-row { display: flex; gap: 8px; align-items: center; margin-bottom: 8px; flex-wrap: wrap; }
        .extra-row-top { display: flex; gap: 8px; align-items: center; width: 100%; }
        .extra-title-input { width: 100%; margin-top: 4px; font-size: 12px; padding: 7px 10px; border: 1.5px solid #e5e7eb; border-radius: 8px; color: #374151; background: #f9fafb; outline: none; }
        .extra-title-input:focus { border-color: #2563eb; background: #fff; }
        .extra-select { width: 44%; flex-shrink: 0; padding: 10px 8px; border: 1.5px solid #e5e7eb; border-radius: 9px; font-size: 13px; color: #374151; background: #f9fafb; outline: none; cursor: pointer; }
        .extra-select:focus { border-color: #2563eb; background: #fff; }
        .extra-value-input { flex: 1; }
        .extra-remove-btn { width: 34px; height: 34px; border-radius: 8px; border: 1.5px solid #fecaca; background: #fff; color: #dc2626; font-size: 14px; cursor: pointer; display: flex; align-items: center; justify-content: center; flex-shrink: 0; transition: background 0.15s; }
        .extra-remove-btn:hover { background: #fee2e2; }
        .btn-add-extra { display: flex; align-items: center; justify-content: center; gap: 6px; width: 100%; padding: 10px; border-radius: 9px; border: 1.5px dashed #bfdbfe; background: #f8faff; color: #2563eb; font-size: 13px; font-weight: 700; cursor: pointer; transition: background 0.15s; }
        .btn-add-extra:hover { background: #eff6ff; border-color: #2563eb; }
        .badge-active   { background: #dcfce7; color: #16a34a; border: 1px solid #bbf7d0; border-radius: 20px; padding: 2px 8px; font-size: 10px; font-weight: 700; }
        .badge-inactive { background: #fee2e2; color: #dc2626; border: 1px solid #fecaca; border-radius: 20px; padding: 2px 8px; font-size: 10px; font-weight: 700; }

        /* ── Two-column layout: form left, preview right ── */
        .page-layout {
            display: flex;
            align-items: flex-start;
            gap: 40px;
            width: 100%;
            max-width: 1100px;
            margin: 0 auto;
            padding: 30px 24px 60px;
        }
        .page-layout .wrap {
            flex: 1;
            min-width: 0;
            padding: 0;
        }
        /* Right sticky preview panel */
        .preview-panel {
            width: 380px;
            flex-shrink: 0;
            position: sticky;
            top: 24px;
            display: flex;
            flex-direction: column;
            gap: 12px;
        }
        .preview-panel-label {
            color: rgba(255,255,255,0.45);
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 2px;
            text-transform: uppercase;
            text-align: center;
        }
        /* Make preview card look like the real card */
        .preview-panel .preview-card {
            padding: 28px 20px 24px;
            border-radius: 20px;
            border-top: 5px solid #2563eb;
        }
        .preview-panel .preview-avatar {
            width: 80px; height: 80px;
            border-radius: 50%;
            margin: 0 auto 12px;
        }
        .preview-panel .preview-avatar img {
            width: 80px; height: 80px;
        }
        .preview-sub-name {
            color: #64748b;
            font-size: 12px;
            margin-bottom: 2px;
        }
        /* On small screens hide the panel, show the FAB instead */
        @@media (max-width: 860px) {
            .page-layout { display: block; padding: 30px 16px 60px; }
            .preview-panel { display: none; }
        }
        @@media (min-width: 861px) {
            .preview-fab { display: none; }
        }
    </style>
</head>
<body>
<div class="bg"></div>
<div class="page-layout">
  <!-- ── Left: Form ── -->
  <div class="wrap">
    <a href="/" class="back">← Back to Home</a>
    <div class="card">

        <div class="photo-section">
            <input type="file" id="photoFileInput" accept="image/*" style="display:none;" onchange="handlePhotoFile(this)" />
            <input type="file" id="photoCameraInput" accept="image/*" capture="user" style="display:none;" onchange="handlePhotoFile(this)" />
            <p class="photo-section-label">Profile Photo</p>
            <div class="photo-top-wrap">
                <div class="photo-top-circle" id="photoTopCircle">
                    @if (!string.IsNullOrWhiteSpace(Model.Photo) && Model.Photo.StartsWith("data:"))
                    { <img src="@Model.Photo" alt="Photo" /> }
                    else if (Model.Photo == "avatar:male")
                    { <img src="/dbp-boy.png" alt="Male" style="width:100%;height:100%;object-fit:cover;display:block;" /> }
                    else if (Model.Photo == "avatar:female")
                    { <img src="/dbp-girl.png" alt="Female" style="width:100%;height:100%;object-fit:cover;display:block;" /> }
                    else
                    { <img src="/dbp-logo.png" alt="DBP" style="width:58px;height:58px;object-fit:contain;" /> }
                </div>
                <div class="camera-badge" onclick="openPhotoSheet()"><i class="fa-solid fa-camera"></i></div>
            </div>
            <div class="photo-toggle-row">
                <input type="hidden" name="ShowPhoto" id="hShowPhoto" value="@(Model.ShowPhoto ? "true" : "false")" />
                <button type="button" id="eyePhoto" class="eye-toggle @(!Model.ShowPhoto ? "hidden" : "")" onclick="eyeToggle('hShowPhoto','eyePhoto',null)" title="Toggle photo visibility">
                    <i class="fa-regular @(Model.ShowPhoto ? "fa-eye" : "fa-eye-slash")"></i>
                </button>
                <span style="font-size:11px;color:#9ca3af;">Show on card</span>
            </div>
        </div>

        <div class="photo-sheet-overlay" id="photoSheetOverlay" onclick="closePhotoSheet()">
            <div class="photo-sheet" onclick="event.stopPropagation()">
                <p class="photo-sheet-title">Choose Photo</p>
                <div class="photo-sheet-options">
                    <button type="button" class="sheet-option" onclick="document.getElementById('photoCameraInput').click(); closePhotoSheet()">
                        <div class="sheet-option-icon"><i class="fa-solid fa-camera"></i></div>
                        <div class="sheet-option-text"><strong>Take Photo</strong><span>Open camera to take a selfie</span></div>
                    </button>
                    <button type="button" class="sheet-option" onclick="document.getElementById('photoFileInput').click(); closePhotoSheet()">
                        <div class="sheet-option-icon"><i class="fa-solid fa-image"></i></div>
                        <div class="sheet-option-text"><strong>Upload Image</strong><span>Choose a photo from your device</span></div>
                    </button>
                    <button type="button" class="sheet-option" onclick="setAvatar('avatar:male'); closePhotoSheet()">
                        <div class="sheet-option-icon male-icon"><img src="/dbp-boy.png" alt="Male" style="width:28px;height:28px;object-fit:contain;" /></div>
                        <div class="sheet-option-text"><strong>Male Avatar</strong><span>Use default male icon</span></div>
                    </button>
                    <button type="button" class="sheet-option" onclick="setAvatar('avatar:female'); closePhotoSheet()">
                        <div class="sheet-option-icon female-icon"><img src="/dbp-girl.png" alt="Female" style="width:28px;height:28px;object-fit:contain;" /></div>
                        <div class="sheet-option-text"><strong>Female Avatar</strong><span>Use default female icon</span></div>
                    </button>
                </div>
                <button type="button" class="sheet-cancel" onclick="closePhotoSheet()">Cancel</button>
            </div>
        </div>

        <h1>@(isExisting ? "Edit My Card" : "Create My Card")</h1>
        <p class="sub">Development Bank of the Philippines</p>
        <div class="divider"></div>

        @if (TempData["Error"] != null) { <div class="alert alert-error">⚠️ @TempData["Error"]</div> }
        @if (TempData["Reset"] != null) { <div class="alert alert-info">Card reset. Fill in your details again.</div> }
        @if (TempData["AdPrefilled"] != null)
        {
            <div class="alert alert-ad">
                <span class="ad-icon">🏢</span>
                <span>Some fields were pre-filled from your Active Directory profile. Review and update anything before saving.</span>
            </div>
        }
        @if (!isExisting)
        {
            <div id="adBanner" class="alert alert-ad" style="display:none;">
                <span class="ad-icon">🏢</span>
                <span>Some fields were pre-filled from your Active Directory profile. Review and update anything before saving.</span>
            </div>
        }

        <form method="post" action="/me/save">
            @Html.AntiForgeryToken()
            <input type="hidden" name="Photo" id="photoData" value="@Model.Photo" />

            <p class="section-title">Employee Identity</p>
            <div class="form-group">
                <div class="field-header"><label>Employee ID *</label></div>
                @if (isExisting)
                {
                    <input type="text" value="@Model.EmpId" readonly class="empid" />
                    <input type="hidden" name="EmpId" value="@Model.EmpId" />
                    <p class="hint">Permanent — tied to your unique QR code.</p>
                }
                else
                {
                    <input type="text" name="EmpId" id="empIdInput" value="" placeholder="e.g. 0000001-DBP" class="empid" maxlength="11" required autocomplete="off" pattern="\d{7}-[A-Za-z]{3}" title="Format: 7 digits, dash, 3 letters"
                           onblur="onEmpIdBlur(this.value)" />
                    <p class="hint">Format: 7 digits – 3 letters (e.g. 0000001-DBP). Permanent.</p>
                    <p class="hint" id="adFillStatus" style="display:none;color:#065f46;font-weight:700;"></p>
                }
            </div>

            <!-- PIN Protection — hidden by default, revealed via modal on save -->
            <input type="password" name="CardPin" value="" id="cardPinInput"
                   maxlength="6" inputmode="numeric" autocomplete="off" style="display:none;"
                   oninput="this.value=this.value.replace(/[^0-9]/g,''); this.classList.remove('pin-error'); document.getElementById('pinErrMsg').classList.remove('show');"
                   onkeypress="return /[0-9]/.test(event.key);"
                   onpaste="var e=event; setTimeout(function(){ e.target.value=e.target.value.replace(/[^0-9]/g,''); },0);" />
            <p class="pin-error-msg" id="pinErrMsg">⚠️ This card has a PIN — enter it to save changes.</p>

            <!-- Card Active Toggle -->
            <div class="form-group">
                <div class="field-header">
                    <label>Card Status</label>
                    <div class="toggle-wrap" style="gap:6px;">
                        <span id="activeLabel" class="toggle-badge @(Model.IsActive ? "badge-active" : "badge-inactive")">@(Model.IsActive ? "Active" : "Inactive")</span>
                        <input type="hidden" name="IsActive" id="hIsActive" value="@(Model.IsActive ? "true" : "false")" />
                        <button type="button" id="eyeActive" class="eye-toggle @(!Model.IsActive ? "hidden" : "")" onclick="toggleActive()" title="Toggle card active/inactive">
                            <i class="fa-regular @(Model.IsActive ? "fa-eye" : "fa-eye-slash")"></i>
                        </button>
                    </div>
                </div>
                <p class="hint" id="activeHint">@(Model.IsActive ? "Your card is visible to anyone with the link." : "Your card is hidden — visitors see 'Card Unavailable'.")</p>
            </div>

            <!-- ATM Card Expiry -->
            <div class="form-group">
                <div class="field-header">
                    <label><i class="fa-solid fa-credit-card" style="margin-right:5px;color:#2563eb;font-size:10px;"></i>ATM Card Expiry <span style="font-weight:400;text-transform:none;letter-spacing:0;color:#9ca3af;">(MM/YY)</span><span id="expiryBadge" style="display:none;"></span></label>
                    @if (Model.IsExpired)
                    {
                        <span style="background:#fee2e2;color:#dc2626;font-size:10px;font-weight:700;padding:2px 8px;border-radius:10px;">⚠️ Expired</span>
                    }
