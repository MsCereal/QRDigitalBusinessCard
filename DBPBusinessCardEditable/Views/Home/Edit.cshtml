    function removeExtraRow(btn) {
        btn.closest('.extra-row').remove();
    }

    function updateExtraPlaceholder(select) {
        // placeholder hook for future use
    }

    // ── Live Preview ──────────────────────────────────────────────────────────
    function g(name) { var el = document.querySelector('[name="' + name + '"]'); return el ? el.value.trim() : ''; }
    function shown(id) { var el = document.getElementById(id); return !el || el.value === 'true'; }

    function pBtn(icon, text) {
        return '<div style="display:flex;align-items:center;gap:7px;padding:6px 10px;margin:3px 0;border-radius:8px;border:1.5px solid #2563eb;color:#2563eb;font-size:11px;font-weight:700;">'
             + '<i class="' + icon + '" style="width:13px;text-align:center;font-size:11px;"></i>' + text + '</div>';
    }

    function updatePreview() {
        var name  = g('Name'), nick = g('PreferredName'), title = g('Title'), dept = g('Department');
        var org   = g('Org'),  phone = g('Phone'), email = g('Email'), office = g('Office');
        var github= g('GitHub'), linkedin = g('LinkedIn'), portfolio = g('Portfolio');
        var photoData = (document.getElementById('photoData') || {}).value || '';

        var sName = shown('hShowName'), sNick = shown('hShowPreferredName');
        var sTitle= shown('hShowTitle'), sDept = shown('hShowDepartment'), sOrg = shown('hShowOrg');
        var sPhone= shown('hShowPhone'), sEmail= shown('hShowEmail'), sOffice = shown('hShowOffice');
        var sGH   = shown('hShowGitHub'), sLI = shown('hShowLinkedIn'), sPF = shown('hShowPortfolio');
        var sPhoto= shown('hShowPhoto');

        var displayName = (sNick && nick) ? nick : (sName && name ? name : '—');

        ['', 'M', 'D'].forEach(function(s) {
            // Photo
            var wrap = document.getElementById('prevPhotoWrap' + s);
            if (wrap) {
                var ph = '';
                if (!sPhoto || !photoData)          ph = '<img src="/dbp-logo.png" style="width:42px;height:42px;object-fit:contain;" />';
                else if (photoData.startsWith('data:')) ph = '<img src="' + photoData + '" style="width:64px;height:64px;border-radius:50%;object-fit:cover;display:block;margin:0 auto;" />';
                else if (photoData === 'avatar:male')   ph = '<img src="/dbp-boy.png"  style="width:64px;height:64px;border-radius:50%;object-fit:cover;display:block;margin:0 auto;" />';
                else if (photoData === 'avatar:female') ph = '<img src="/dbp-girl.png" style="width:64px;height:64px;border-radius:50%;object-fit:cover;display:block;margin:0 auto;" />';
                else ph = '<img src="/dbp-logo.png" style="width:42px;height:42px;object-fit:contain;" />';
                wrap.innerHTML = ph;
            }
        // Name — show preferred name as main, full name as subtitle (same as real card)
        var nEl = document.getElementById('prevName' + s);
        if (nEl) {
            nEl.textContent = displayName;
            var hint = document.getElementById('prevHint' + s);
            if (hint) hint.style.display = (name || nick) ? 'none' : '';
        }
        // Sub-name — show full name below nickname when nickname is active
        var snEl = document.getElementById('prevSubName' + s);
        if (snEl) {
            var showSub = sNick && nick && sName && name && nick !== name;
            snEl.textContent = showSub ? name : '';
            snEl.style.display = showSub ? '' : 'none';
        }
            // Subtitle fields
            var tEl = document.getElementById('prevTitle' + s);
            if (tEl) { tEl.textContent = title; tEl.style.display = (sTitle && title) ? '' : 'none'; }
            var dEl = document.getElementById('prevDept' + s);
            if (dEl) { dEl.textContent = dept; dEl.style.display = (sDept && dept) ? '' : 'none'; }
            var oEl = document.getElementById('prevOrg' + s);
            if (oEl) { oEl.textContent = org; oEl.style.display = (sOrg && org) ? '' : 'none'; }
            // Buttons
            var btns = document.getElementById('prevBtns' + s);
            if (btns) {
                var html = '';
                if (sPhone && phone) html += pBtn('fa-solid fa-phone', 'Call Now');
                if (sEmail && email) html += pBtn('fa-solid fa-envelope', 'Send Email');
                if ((sPhone && phone) || (sEmail && email)) html += pBtn('fa-solid fa-address-card', 'Save Contact');
                if (sGH && github)   html += pBtn('fa-brands fa-github', 'View GitHub');
                if (sLI && linkedin) html += pBtn('fa-brands fa-linkedin', 'View LinkedIn');
                if (sPF && portfolio)html += pBtn('fa-solid fa-globe', 'Visit Website');
                if (sOffice && office) html += pBtn('fa-solid fa-location-dot', office.length > 24 ? office.slice(0,24)+'…' : office);
                // Extra info rows
                var extraRows = document.querySelectorAll('#extraInfoList .extra-row');
                var extraIcons = {'facebook':'fa-brands fa-facebook','instagram':'fa-brands fa-instagram','twitter':'fa-brands fa-x-twitter','x.com':'fa-brands fa-x-twitter','tiktok':'fa-brands fa-tiktok','youtube':'fa-brands fa-youtube','messenger':'fa-brands fa-facebook-messenger','whatsapp':'fa-brands fa-whatsapp','viber':'fa-brands fa-viber','telegram':'fa-brands fa-telegram','skype':'fa-brands fa-skype','discord':'fa-brands fa-discord','snapchat':'fa-brands fa-snapchat','department':'fa-solid fa-building','birthday':'fa-solid fa-cake-candles'};
                extraRows.forEach(function(row) {
                    var sel = row.querySelector('select');
                    var val = row.querySelector('.extra-value-input');
                    var ttl = row.querySelector('.extra-title-input');
                    if (!sel || !val || !val.value.trim()) return;
                    var labelKey = sel.value.toLowerCase().replace(/ \/ /g, ' ').replace(/\//g, '');
                    var icon = 'fa-solid fa-link';
                    Object.keys(extraIcons).forEach(function(k) { if (labelKey.includes(k)) icon = extraIcons[k]; });
                    var displayLabel = (ttl && ttl.value.trim()) ? ttl.value.trim() : sel.value;
                    html += pBtn(icon, displayLabel.length > 22 ? displayLabel.slice(0,22)+'…' : displayLabel);
                });
                btns.style.display = html ? '' : 'none';
                btns.innerHTML = html;
            }
        });
    }

    // Attach listeners using event delegation — works for dynamically added rows too
    document.addEventListener('DOMContentLoaded', function() {
        updatePreview();
        // Show expiry badge for existing value on load
        var expiryInput = document.getElementById('cardExpiryInput');
        if (expiryInput && expiryInput.value) checkExpiry(expiryInput.value);
        document.addEventListener('input',  function() { updatePreview(); });
        document.addEventListener('change', function() { updatePreview(); });
        document.addEventListener('click',  function(e) {
            if (e.target.closest('.eye-toggle')) setTimeout(updatePreview, 40);
        });
    });

    // PIN validation is now handled by the PIN modal above

    function openPreviewModal()  { document.getElementById('previewModalOverlay').classList.add('open'); updatePreview(); }
    function closePreviewModal() { document.getElementById('previewModalOverlay').classList.remove('open'); }

    // Warn user if they try to leave with unsaved changes
    var _formDirty = false;
    document.addEventListener('DOMContentLoaded', function() {
        var form = document.querySelector('form[action="/me/save"]');
        if (form) {
            form.addEventListener('change', function() { _formDirty = true; });
            form.addEventListener('input',  function() { _formDirty = true; });
            form.addEventListener('submit', function() { _formDirty = false; });
        }
    });
    window.addEventListener('beforeunload', function(e) {
        if (_formDirty) {
            e.preventDefault();
            e.returnValue = 'You have unsaved changes. Are you sure you want to leave?';
        }
    });

    function formatExpiry(input) {
        var v = input.value.replace(/\D/g, '').slice(0, 4);
        if (v.length >= 3) v = v.slice(0,2) + '/' + v.slice(2);
        input.value = v;
        checkExpiry(input.value);
    }

    function checkExpiry(val) {
        var badge = document.getElementById('expiryBadge');
        if (!badge) return;
        var parts = (val || '').split('/');
        if (parts.length !== 2 || parts[0].length !== 2 || parts[1].length !== 2) {
            badge.textContent = '';
            badge.style.display = 'none';
            return;
        }
        var mm = parseInt(parts[0], 10);
        var yy = parseInt(parts[1], 10);
        if (mm < 1 || mm > 12) {
            badge.textContent = '⚠️ Invalid month';
            badge.style.cssText = 'display:inline-block;background:#fee2e2;color:#dc2626;font-size:10px;font-weight:700;padding:2px 8px;border-radius:10px;margin-left:8px;';
            return;
        }
        var fullYear = 2000 + yy;
        var expiry   = new Date(fullYear, mm, 0, 23, 59, 59); // last day of that month
        var now      = new Date();
        if (expiry < now) {
            badge.textContent = '❌ Expired';
            badge.style.cssText = 'display:inline-block;background:#fee2e2;color:#dc2626;font-size:10px;font-weight:700;padding:2px 8px;border-radius:10px;margin-left:8px;';
        } else {
            var months = (fullYear - now.getFullYear()) * 12 + (mm - (now.getMonth()+1));
            badge.textContent = months <= 3 ? '⚠️ Expiring soon' : '✅ Valid';
            badge.style.cssText = months <= 3
                ? 'display:inline-block;background:#fef3c7;color:#b45309;font-size:10px;font-weight:700;padding:2px 8px;border-radius:10px;margin-left:8px;'
                : 'display:inline-block;background:#dcfce7;color:#15803d;font-size:10px;font-weight:700;padding:2px 8px;border-radius:10px;margin-left:8px;';
        }
    }

    function openEditResetModal() {
        // If card has a PIN, show a PIN entry modal before resetting
        if (cardHasPin) {
            document.getElementById('resetPinModalOverlay').style.display = 'flex';
            var rpin = document.getElementById('resetPinModalInput');
            if (rpin) { rpin.value = ''; setTimeout(function(){ rpin.focus(); }, 100); }
        } else {
            if (!confirm('Reset your card? All info will be cleared. This cannot be undone.')) return;
            document.querySelector('form[action="/me/reset"]').submit();
        }
    }
    function closeResetPinModal() {
        document.getElementById('resetPinModalOverlay').style.display = 'none';
    }
    function confirmResetPin() {
        var pin = (document.getElementById('resetPinModalInput').value || '').trim();
        document.getElementById('editResetPinHidden').value = pin;
        document.getElementById('resetPinModalOverlay').style.display = 'none';
        if (!confirm('Reset your card? All info will be cleared. This cannot be undone.')) return;
        document.querySelector('form[action="/me/reset"]').submit();
    }

    // ── PIN Modal ──────────────────────────────────────────────────────────────
    var cardHasPin = @(string.IsNullOrWhiteSpace(Model.CardPin) ? "false" : "true");
    var _pendingSave = false;

    function handleSave() {
        // If card has existing PIN, show modal to confirm before saving
        if (cardHasPin) {
            _pendingSave = true;
            openPinModal();
        } else {
            // No existing PIN — submit directly (user can set one via lock button separately)
            document.querySelector('form[action="/me/save"]').submit();
        }
    }

    function openPinModal() {
        var modal  = document.getElementById('pinModalOverlay');
        var input  = document.getElementById('pinModalInput');
        var title  = document.getElementById('pinModalTitle');
        var sub    = document.getElementById('pinModalSub');
        var hint   = document.getElementById('pinModalHint');

        if (cardHasPin && _pendingSave) {
            title.textContent = 'Enter Your PIN';
            sub.textContent   = 'Enter your PIN to confirm and save changes.';
            hint.textContent  = 'Leave blank to keep your current PIN unchanged.';
        } else if (cardHasPin) {
            title.textContent = 'Change PIN';
            sub.textContent   = 'Enter a new PIN to replace your current one.';
            hint.textContent  = 'Leave blank to keep your current PIN unchanged.';
        } else {
            title.textContent = 'Set a PIN';
            sub.textContent   = 'Optional — protects your card from unauthorized edits.';
            hint.textContent  = 'Leave blank to save without a PIN.';
        }

        input.value = '';
        modal.style.display = 'flex';
        setTimeout(function() { input.focus(); }, 100);
    }

    function closePinModal() {
        document.getElementById('pinModalOverlay').style.display = 'none';
        _pendingSave = false;
    }

    function confirmPin() {
        var pin = document.getElementById('pinModalInput').value.trim();

        // Validate format if a PIN was entered
        if (pin.length > 0 && (pin.length < 4 || pin.length > 6)) {
            var input = document.getElementById('pinModalInput');
            input.style.borderColor = '#dc2626';
            input.style.background  = '#fef2f2';
            document.getElementById('pinModalHint').textContent = '⚠️ PIN must be 4–6 digits.';
            document.getElementById('pinModalHint').style.color = '#dc2626';
            return;
        }

        // Copy PIN value to the hidden input in the form
        document.getElementById('cardPinInput').value = pin;
        document.getElementById('pinModalOverlay').style.display = 'none';

        // Update lock button appearance
        var lockBtn = document.getElementById('pinLockBtn');
        var icon    = lockBtn ? lockBtn.querySelector('i') : null;
        if (pin.length > 0) {
            // PIN was set or changed — show locked blue
            if (lockBtn) { lockBtn.style.borderColor='#2563eb'; lockBtn.style.background='#eff6ff'; lockBtn.style.color='#2563eb'; }
            if (icon)    icon.className = 'fa-solid fa-lock';
            cardHasPin = true;
        } else if (!cardHasPin) {
            // No PIN entered and no existing PIN — stay grey unlocked
            if (lockBtn) { lockBtn.style.borderColor='#e5e7eb'; lockBtn.style.background='#f9fafb'; lockBtn.style.color='#9ca3af'; }
            if (icon)    icon.className = 'fa-solid fa-lock-open';
        }
        // If pin is blank but cardHasPin=true, PIN is unchanged — keep locked appearance

        if (_pendingSave) {
            _pendingSave = false;
            document.querySelector('form[action="/me/save"]').submit();
        }
    }

    function removePinFromModal() {
        if (!confirm('Remove your PIN? Anyone will be able to edit your card without a PIN.')) return;
        var form     = document.querySelector('form[action="/me/save"]');
        var pinInput = document.getElementById('cardPinInput');
        pinInput.value = '';

        // Add resetPin flag
        var existing = document.getElementById('pinResetFlag');
        if (!existing) {
            var flag = document.createElement('input');
            flag.type = 'hidden'; flag.name = 'resetPin'; flag.value = 'true'; flag.id = 'pinResetFlag';
            form.appendChild(flag);
        }

        // Update lock button
        var lockBtn = document.getElementById('pinLockBtn');
        if (lockBtn) { lockBtn.style.borderColor='#e5e7eb'; lockBtn.style.background='#f9fafb'; lockBtn.style.color='#9ca3af'; }
        var icon = lockBtn ? lockBtn.querySelector('i') : null;
        if (icon) icon.className = 'fa-solid fa-lock-open';

        cardHasPin = false;
        document.getElementById('pinModalOverlay').style.display = 'none';
    }

    // -------------------------------------------------------------------
    // AD pre-fill — fires when the user finishes typing their Employee ID.
    // 1. Checks /check/{empId} — if card already exists, redirects to /setup
    //    so the existing card loads (no overwrite).
    // 2. If new card — fetches /api/me for the signed-in Windows user's AD
    //    data and fills in blank fields automatically.
    // -------------------------------------------------------------------
    @if (!isExisting)
    {
        <text>
    var _adFetched = false;

    function onEmpIdBlur(empId) {
        empId = (empId || '').trim();
        if (!empId) return;

        // Validate format first — only proceed if it looks right
        if (!/^\d{7}-[A-Za-z]{3}$/.test(empId)) return;

        // Step 1: check if this EmpId already has a card
        fetch('/check/' + encodeURIComponent(empId), { credentials: 'include' })
            .then(function(r) { return r.json(); })
            .then(function(d) {
                if (d.exists) {
                    // Card exists — redirect to setup so the existing data loads
                    window.location.href = '/setup?empId=' + encodeURIComponent(empId);
                    return;
                }
                // New card — pull AD data for the current Windows user
                if (_adFetched) return;
                _adFetched = true;
                fillFromAd();
            })
            .catch(function() { fillFromAd(); });
    }

    function fillFromAd() {
        fetch('/api/me', { credentials: 'include' })
            .then(function(r) { return r.ok ? r.json() : null; })
            .then(function(d) {
                if (!d || !d.found) return;

                var banner = document.getElementById('adBanner');
                var status = document.getElementById('adFillStatus');
                var filled = [];

                function fill(fieldId, value, label) {
                    if (!value) return;
                    var el = document.getElementById(fieldId);
                    if (el && !el.value) {
                        el.value = value;
                        filled.push(label);
                    }
                }

                fill('fieldName',       d.displayName,     'Name');
                fill('fieldTitle',      d.title,           'Title');
                fill('fieldDepartment', d.department,      'Department');
                fill('fieldEmail',      d.mail,            'Email');
                fill('fieldPhone',      d.telephoneNumber, 'Phone');

                if (filled.length > 0) {
                    if (banner) banner.style.display = 'flex';
                    if (status) {
                        status.textContent = '✓ Pre-filled from AD: ' + filled.join(', ');
                        status.style.display = 'block';
                    }
                    if (typeof updatePreview === 'function') updatePreview();
                }
            })
            .catch(function() { /* AD unreachable — silently skip */ });
    }
        </text>
    }
</script>
