                       oninput="formatExpiry(this)"
                       style="font-family:monospace;font-size:15px;letter-spacing:2px;" />
                <p class="hint">
                    Your digital business card will automatically deactivate when your ATM card expires.
                    @if (Model.CardExpiresAt.HasValue)
                    {
                        var expiryUtc = DateTime.SpecifyKind(Model.CardExpiresAt.Value, DateTimeKind.Utc);
                        var phtTz     = TimeZoneInfo.GetSystemTimeZones()
                                        .FirstOrDefault(z => z.Id == "Asia/Manila" || z.Id == "Singapore Standard Time")
                                        ?? TimeZoneInfo.Utc;
                        var phtExpiry = TimeZoneInfo.ConvertTimeFromUtc(expiryUtc, phtTz);
                        <text>Expires: <strong>@phtExpiry.ToString("MMMM yyyy")</strong></text>
                    }
                </p>
