@model DBPBusinessCardEditable.Models.CardProfile
@{ Layout = null; }
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>DBP – Enter PIN</title>
    <link rel="icon" type="image/png" href="/dbp-icon.png" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
        body { font-family: Arial, sans-serif; min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 20px; position: relative; overflow: hidden; }
        .bg { position: fixed; inset: 0; z-index: 0; background: linear-gradient(155deg, rgba(10,25,70,0.95) 0%, rgba(30,64,175,0.90) 45%, rgba(15,40,100,0.97) 100%), url('/bg.png') center/cover no-repeat; }
        .card { position: relative; z-index: 1; background: #fff; border-radius: 20px; padding: 36px 28px; max-width: 360px; width: 100%; text-align: center; box-shadow: 0 16px 48px rgba(0,0,0,0.35); border-top: 5px solid #2563eb; }
        .lock-icon { font-size: 40px; color: #2563eb; margin-bottom: 14px; }
        h1 { color: #0f172a; font-size: 20px; font-weight: 800; margin-bottom: 6px; }
        .sub { color: #64748b; font-size: 13px; margin-bottom: 24px; }
        .emp-badge { display: inline-block; background: #eff6ff; border: 1px solid #bfdbfe; color: #1d4ed8; font-size: 11px; font-weight: 700; padding: 3px 12px; border-radius: 20px; letter-spacing: 1px; margin-bottom: 20px; }
        .pin-input {
            width: 100%; padding: 14px; border: 2px solid #e5e7eb; border-radius: 12px;
            font-size: 22px; font-weight: 800; text-align: center; letter-spacing: 8px;
            color: #0f172a; background: #f9fafb; outline: none;
            transition: border-color 0.15s, box-shadow 0.15s;
            margin-bottom: 14px;
        }
        .pin-input:focus { border-color: #2563eb; background: #fff; box-shadow: 0 0 0 3px rgba(37,99,235,0.12); }
        .btn-submit {
            width: 100%; padding: 13px; border: none; border-radius: 11px;
            background: linear-gradient(135deg, #2563eb, #1d4ed8);
            color: #fff; font-size: 15px; font-weight: 800; cursor: pointer;
            box-shadow: 0 4px 14px rgba(37,99,235,0.35);
            transition: box-shadow 0.15s, transform 0.1s;
        }
        .btn-submit:hover { box-shadow: 0 6px 20px rgba(37,99,235,0.45); }
        .btn-submit:active { transform: scale(0.97); }
        .error { background: #fee2e2; color: #b91c1c; border-radius: 9px; padding: 10px 14px; font-size: 13px; font-weight: 700; margin-bottom: 14px; }
        .back-link { display: inline-block; margin-top: 16px; color: #94a3b8; font-size: 12px; text-decoration: none; }
        .back-link:hover { color: #475569; }
    </style>
</head>
<body>
<div class="bg"></div>
<div class="card">
    <div class="lock-icon"><i class="fa-solid fa-lock"></i></div>
    <h1>Enter Your PIN</h1>
    <p class="sub">This card is protected. Enter your PIN to edit.</p>
    <span class="emp-badge">@Model.EmpId</span>

    @if (TempData["PinError"] != null)
    {
        <div class="error"><i class="fa-solid fa-circle-exclamation"></i> @TempData["PinError"]</div>
    }

    <form method="post" action="/verify-pin">
        @Html.AntiForgeryToken()
        <input type="hidden" name="empId" value="@Model.EmpId" />
        <input type="password" name="pin" class="pin-input" placeholder="••••"
               maxlength="6" inputmode="numeric" pattern="\d{4,6}"
               autocomplete="off" autofocus />
        <button type="submit" class="btn-submit">
            <i class="fa-solid fa-unlock"></i> Unlock Card
        </button>
    </form>
    <a href="/" class="back-link">← Back to Home</a>
</div>
</body>
</html>
