@model DBPBusinessCardEditable.Models.CardProfile
@{
    Layout = null;
    string empId   = Model.EmpId;
    string cardUrl = $"{Context.Request.Scheme}://{Context.Request.Host}/card/{Model.CardToken}";
    // The QR shown by default is "Save Contact" (contact details inside the QR, saves instantly).
    // Inactive/expired cards have no contact QR, so they show the normal card QR instead.
    bool contactDefault = Model.IsEffectivelyActive;
    var stats = Model.ViewHistory != null ? Model.ViewHistory : new System.Collections.Generic.List<DBPBusinessCardEditable.Models.DailyView>();
    int todayViews = stats.Where(v => v.Date == DateTime.UtcNow.ToString("yyyy-MM-dd")).Sum(v => v.Count);
    int weekViews  = stats.Where(v => string.Compare(v.Date, DateTime.UtcNow.AddDays(-7).ToString("yyyy-MM-dd"), StringComparison.Ordinal) >= 0).Sum(v => v.Count);
    int totalViews = Model.TotalViews;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>DBP – @Model.Name</title>
    <link rel="icon" type="image/png" href="/dbp-icon.png" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
        body { font-family: Arial, sans-serif; min-height: 100vh; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 74px 20px 20px; overflow-y: auto; overflow-x: hidden; position: relative; }
        .bg { position: fixed; inset: 0; z-index: 0; background: linear-gradient(155deg, rgba(10,25,70,0.93) 0%, rgba(30,64,175,0.88) 45%, rgba(15,40,100,0.96) 100%), url('/bg.png') center/cover no-repeat; }
        .topnav { position: fixed; top: 0; left: 0; right: 0; z-index: 10; padding: 14px 24px; display: flex; align-items: center; }
        .brand { display: flex; align-items: center; gap: 12px; text-decoration: none; }
        .brand img { height: 38px; object-fit: contain; }
        .brand-text { color: #f1f5f9; font-size: 15px; font-weight: 700; }
        .wrap { position: relative; z-index: 1; width: 100%; max-width: 560px; text-align: center; }
        /* Laptop / desktop: profile + QR on the left, actions on the right, so the page fits one screen */
        .qr-layout { display: grid; grid-template-columns: minmax(0, 1fr); gap: 16px; align-items: stretch; }
        .qr-col-left { display: flex; flex-direction: column; }
        .qr-col-left .qr-card { flex: 1; display: flex; flex-direction: column; justify-content: center; }
        .qr-col-left .qr-frame { align-self: center; }
        /* Actions live in a card that matches the QR card (no backdrop-filter here: it would trap the fixed reset modal) */
        .qr-col-right { background: rgba(255,255,255,0.07); border: 1px solid rgba(255,255,255,0.14); border-radius: 20px; padding: 18px 20px; display: flex; flex-direction: column; justify-content: center; gap: 16px; }
        .qr-col-right .link-section, .qr-col-right .share-section { margin-bottom: 0; }
        .qr-col-right > div[style*="margin-top:10px"] { margin-top: 0 !important; }
        @@media (min-width: 860px) {
            .wrap { max-width: 860px; }
            .qr-layout { grid-template-columns: 1fr 1fr; gap: 20px; }
            .divider-row { max-width: none; }
        }
        .profile { margin-bottom: 14px; }
        .profile-photo, .profile-photo-placeholder { width: 64px; height: 64px; border-radius: 50%; object-fit: cover; border: 3px solid rgba(255,255,255,0.35); box-shadow: 0 4px 16px rgba(0,0,0,0.3); display: block; margin: 0 auto; }
        .profile-photo-placeholder { background: rgba(37,99,235,0.4); display: flex; align-items: center; justify-content: center; overflow: hidden; }
        .profile-photo-placeholder i { font-size: 32px; color: rgba(255,255,255,0.6); }
        .profile-photo-placeholder img { width: 100%; height: 100%; object-fit: cover; display: block; }
        .profile-name { color: #fff; font-size: 20px; font-weight: 800; margin: 10px 0 5px; text-shadow: 0 1px 6px rgba(0,0,0,0.4); }
        .profile-title-pill { display: inline-block; background: rgba(255,255,255,0.15); border: 1px solid rgba(255,255,255,0.2); color: #f1f5f9; font-size: 12px; font-weight: 600; padding: 4px 12px; border-radius: 20px; backdrop-filter: blur(4px); }
        .qr-card { position: relative; background: rgba(255,255,255,0.07); border: 1px solid rgba(255,255,255,0.14); border-radius: 20px; padding: 16px; margin-bottom: 0; backdrop-filter: blur(8px); }
        .qr-frame { background: #fff; border-radius: 14px; padding: 12px; display: inline-block; box-shadow: 0 8px 30px rgba(0,0,0,0.4); margin-bottom: 10px; animation: pulse 3s ease-in-out infinite; }
        @@keyframes pulse { 0%,100% { box-shadow: 0 8px 30px rgba(0,0,0,0.4); } 50% { box-shadow: 0 8px 30px rgba(0,0,0,0.4), 0 0 0 6px rgba(37,99,235,0.2); } }
        .qr-frame img { display: block; width: 200px; height: 200px; border-radius: 4px; }
        .qr-instruction { color: #ffffff; font-size: 15px; font-weight: 700; margin-bottom: 4px; }
        /* Open Card / Save Contact switch */
        .qr-type { display: none; gap: 6px; background: rgba(0,0,0,0.22); border: 1px solid rgba(255,255,255,0.14); border-radius: 12px; padding: 4px; margin-bottom: 12px; }
        .qr-layout.show-advanced .qr-type { display: flex; }
        /* Hidden by default: Open Card QR switch, Open Card, Copy Link, Share via, Publish. Shown by the hidden button. */
        .qr-layout:not(.show-advanced) .advanced { display: none !important; }
        /* Normal view: ONE centred box - the QR on top, Edit / Stats / Reset joined underneath */
        .qr-layout:not(.show-advanced) { grid-template-columns: minmax(0, 1fr) !important; max-width: 440px; margin: 0 auto; gap: 0 !important; }
        .qr-layout:not(.show-advanced) .qr-col-left .qr-card { border-bottom: 0; border-bottom-left-radius: 0; border-bottom-right-radius: 0; padding-bottom: 12px; }
        .qr-layout:not(.show-advanced) .qr-col-right { border-top: 0; border-top-left-radius: 0; border-top-right-radius: 0; padding: 0 16px 16px !important; gap: 10px; }
        /* Hidden button (top-right corner of the QR box): click to show/hide the hidden parts */
        .qr-secret { position: absolute; top: 0; right: 0; width: 40px; height: 40px; padding: 0; border: 0; background: transparent; opacity: 0; cursor: default; z-index: 2; }
        .qr-type-btn { flex: 1; display: flex; align-items: center; justify-content: center; gap: 7px; padding: 9px 10px; border: 0; border-radius: 9px; background: transparent; color: #ffffff; font-size: 13px; font-weight: 700; cursor: pointer; font-family: inherit; }
        .qr-type-btn:hover, .qr-type-btn:focus-visible { background: rgba(255,255,255,0.16); outline: none; }
        .qr-type-btn.active { background: #ffffff; color: #0b1e4a; }
        .qr-note { color: #bfdbfe; font-size: 12px; margin-top: 6px; display: none; }
        .qr-sub { color: #ffffff; font-size: 13px; }
        .divider-row { display: flex; align-items: center; gap: 10px; margin: 0 auto 14px; max-width: 480px; }
        .divider-row::before, .divider-row::after { content: ''; flex: 1; height: 1px; background: rgba(255,255,255,0.12); }
        .divider-row span { color: #ffffff; font-size: 12px; font-weight: 700; letter-spacing: 2px; white-space: nowrap; }
        .link-section { margin-bottom: 16px; }
        .access-row { display: flex; gap: 10px; }
        .btn { display: flex; align-items: center; justify-content: center; gap: 8px; padding: 13px 16px; border-radius: 12px; font-size: 14px; font-weight: 700; cursor: pointer; border: none; text-decoration: none; transition: background 0.15s, transform 0.1s; flex: 1; }
        .btn:active { transform: scale(0.97); }
        .btn i { font-size: 14px; }
        .btn-open { background: #2563eb; color: #fff; box-shadow: 0 4px 14px rgba(37,99,235,0.4); }
        /* Obvious hover: buttons lift, get a bright fill and a clear border (also on keyboard focus) */
        .btn:not(:disabled):hover, .btn:not(:disabled):focus-visible, .btn-save-qr:hover, .btn-save-qr:focus-visible { transform: translateY(-2px); box-shadow: 0 8px 20px rgba(0,0,0,0.35); outline: none; }
        .btn:not(:disabled):active, .btn-save-qr:active { transform: translateY(0) scale(0.97); }
        .btn { transition: background 0.15s, border-color 0.15s, color 0.15s, transform 0.12s, box-shadow 0.15s; }
        .btn-open:hover, .btn-open:focus-visible { background: #60a5fa; color: #0b1e4a; }
        .btn-copy { background: rgba(255,255,255,0.1); border: 1.5px solid rgba(255,255,255,0.2); color: #f1f5f9; }
        .btn-copy:hover, .btn-copy:focus-visible { background: rgba(255,255,255,0.9); border-color: #ffffff; color: #0b1e4a; }
        .owner-row { display: flex; gap: 10px; }
        .btn-edit { background: rgba(255,255,255,0.08); border: 1.5px solid rgba(255,255,255,0.2); color: #f1f5f9; flex: 1; }
        .btn-edit:hover, .btn-edit:focus-visible { background: rgba(255,255,255,0.9); border-color: #ffffff; color: #0b1e4a; }
        .btn-reset { background: transparent; border: 1.5px solid rgba(255,255,255,0.35); color: #ffffff; font-size: 14px; flex: 1; }
        .btn-reset:hover, .btn-reset:focus-visible { background: #dc2626; border-color: #dc2626; color: #ffffff; }
        .btn-save-qr { display: flex; align-items: center; justify-content: center; gap: 8px; padding: 11px 16px; border-radius: 11px; font-size: 13px; font-weight: 700; cursor: pointer; border: 1.5px solid rgba(255,255,255,0.2); background: rgba(255,255,255,0.08); color: #f1f5f9; transition: background 0.15s, transform 0.1s; }
        .btn-save-qr:hover, .btn-save-qr:focus-visible { background: rgba(255,255,255,0.9); border-color: #ffffff; color: #0b1e4a; }
        .btn-save-qr:active { transform: scale(0.97); }
        .share-section { margin-bottom: 16px; }
        .share-row { display: flex; gap: 10px; }
        .btn-teams { background: rgba(98,100,167,0.25); border: 1.5px solid rgba(98,100,167,0.5); color: #ffffff; flex: 1; }
        .btn-teams:hover, .btn-teams:focus-visible { background: #7c3aed; border-color: #ddd6fe; color: #ffffff; }
        .btn.btn-teams:not(:disabled):hover, .btn.btn-teams:not(:disabled):focus-visible { box-shadow: 0 8px 20px rgba(124,58,237,0.55); }
        /* Plain line that separates Share (Teams / Outlook) from Edit / Stats / Reset */
        .section-line { height: 1px; width: 100%; background: rgba(255,255,255,0.25); flex-shrink: 0; }
        .btn-outlook { background: rgba(0,120,212,0.2); border: 1.5px solid rgba(0,120,212,0.45); color: #ffffff; flex: 1; }
        .btn-outlook:hover, .btn-outlook:focus-visible { background: #0078d4; border-color: #93c5fd; color: #ffffff; }
        .btn-publish { background: #059669; border-color: #059669; }
        .btn-publish:not(:disabled):hover, .btn-publish:not(:disabled):focus-visible { background: #34d399; border-color: #a7f3d0; color: #064e3b; }

        /* ── Stats Panel (inline slide-in) ── */
        .stats-panel {
            display: none;
            position: fixed; inset: 0; z-index: 50;
            background: linear-gradient(155deg, rgba(10,25,70,0.97) 0%, rgba(30,64,175,0.95) 45%, rgba(15,40,100,0.99) 100%);
            overflow-y: auto; padding: 14px 20px 14px;   /* scroll only as a last resort on very short screens */
            animation: fadeIn 0.25s ease;
        }
        /* Fit exactly on one screen: header on top, body fills the rest */
        .stats-panel.open { display: flex; flex-direction: column; }
        @@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
        .stats-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 10px; width: 100%; max-width: 1100px; margin-left: auto; margin-right: auto; flex-shrink: 0; }
        .stats-header h2 { color: #f1f5f9; font-size: 17px; font-weight: 800; }
        .stats-close { background: rgba(255,255,255,0.1); border: 1.5px solid rgba(255,255,255,0.2); color: #f1f5f9; border-radius: 10px; padding: 8px 14px; font-size: 13px; font-weight: 700; cursor: pointer; display: flex; align-items: center; gap: 6px; }
        .stats-close:hover { background: rgba(255,255,255,0.2); }
        .stats-body { width: 100%; max-width: 1100px; margin: 0 auto; flex: 1; min-height: 0; display: flex; flex-direction: column; gap: 4px; }
        .stats-col { display: flex; flex-direction: column; min-width: 0; }
        .stats-col-right { flex: 1; min-height: 190px; }
        #auditSection { display: flex; flex-direction: column; flex: 1; min-height: 0; }
        /* Wide screens: numbers + chart on the left, audit log on the right */
        @@media (min-width: 900px) {
            .stats-body { flex-direction: row; gap: 28px; align-items: stretch; }
            .stats-col-left { width: 46%; flex-shrink: 0; }
            .stats-col-right { min-height: 0; }
        }
        /* Three numbers in one compact row */
        .stats-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; margin-bottom: 6px; }
        .stat-box { background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.12); border-radius: 12px; padding: 10px 6px; text-align: center; }
        .stat-box.total { background: rgba(37,99,235,0.2); border-color: rgba(37,99,235,0.4); }
        .stat-num { font-size: 28px; font-weight: 800; color: #60a5fa; line-height: 1; }
        .stat-box.total .stat-num { font-size: 28px; }
        .stat-lbl { font-size: 12px; color: #ffffff; margin-top: 4px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; }
        .stats-section-title { font-size: 12px; font-weight: 800; letter-spacing: 1.5px; text-transform: uppercase; color: #93c5fd; margin: 0; }

        /* Hide / Show toggle for each stats section */
        .section-head { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin: 6px 0 8px; }
        .toggle-btn { background: rgba(255,255,255,0.1); border: 1.5px solid rgba(255,255,255,0.25); color: #ffffff; border-radius: 8px; padding: 4px 10px; font-size: 12px; font-weight: 700; cursor: pointer; display: inline-flex; align-items: center; gap: 6px; }
        .toggle-btn:hover, .toggle-btn:focus-visible { background: rgba(255,255,255,0.22); outline: none; }
        .is-collapsed { display: none !important; }

        /* Audit log pager */
        .pager { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-top: 8px; flex-shrink: 0; }
        .pager-btn { background: rgba(255,255,255,0.1); border: 1.5px solid rgba(255,255,255,0.25); color: #ffffff; border-radius: 8px; padding: 8px 14px; font-size: 13px; font-weight: 700; cursor: pointer; }
        .pager-btn:hover:not(:disabled), .pager-btn:focus-visible { background: rgba(255,255,255,0.22); outline: none; }
        .pager-btn:disabled { opacity: 0.35; cursor: default; }
        .pager-lbl { color: #ffffff; font-size: 13px; font-weight: 600; }
        .chart-wrap { margin-bottom: 4px; }
        .chart-row { display: flex; align-items: center; gap: 8px; margin-bottom: 3px; }
        .chart-date { font-size: 12px; color: #ffffff; width: 52px; flex-shrink: 0; text-align: right; }
        .chart-track { flex: 1; background: rgba(255,255,255,0.08); border-radius: 4px; height: 10px; overflow: hidden; }
        .chart-fill { height: 100%; background: linear-gradient(90deg, #2563eb, #60a5fa); border-radius: 4px; }
        .chart-count { font-size: 12px; color: #93c5fd; font-weight: 700; width: 22px; text-align: right; flex-shrink: 0; }
        .audit-card { background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); border-radius: 14px; padding: 8px 16px; flex: 1; min-height: 0; overflow: hidden; }
        .audit-row { display: flex; gap: 10px; padding: 7px 0; border-bottom: 1px solid rgba(255,255,255,0.07); align-items: flex-start; }
        .audit-row:last-child { border-bottom: none; }
        .audit-dot { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; margin-top: 5px; }
        .audit-dot.created    { background: #22c55e; }
        .audit-dot.updated    { background: #3b82f6; }
        .audit-dot.reset      { background: #ef4444; }
        .audit-action { font-size: 14px; font-weight: 700; color: #ffffff; }
        .audit-detail { font-size: 13px; color: #ffffff; margin-top: 2px; }
        .audit-time   { font-size: 12px; color: #e2e8f0; margin-top: 2px; }
        .empty { text-align: center; color: #ffffff; font-size: 13px; padding: 20px 0; }

        /* Short laptop screens: slightly smaller photo / QR / gaps so the page + footer fit without scrolling */
        @@media (min-width: 860px) and (max-height: 700px) {
            body { padding-top: 66px; padding-bottom: 8px; }
            .profile { margin-bottom: 8px; }
            .profile-photo, .profile-photo-placeholder { width: 52px; height: 52px; }
            .profile-name { font-size: 18px; margin: 6px 0 4px; }
            .qr-card { padding: 12px 16px; }
            .qr-frame { padding: 10px; margin-bottom: 8px; }
            .qr-frame img { width: 172px; height: 172px; }
            .qr-type { margin-bottom: 8px; padding: 3px; }
            .qr-type-btn { padding: 7px 8px; }
            .btn-save-qr { margin-top: 10px !important; padding: 9px 16px; }
            .qr-col-right { padding: 12px 16px; gap: 10px; }
            .btn { padding: 10px 14px; }
            .divider-row { margin-bottom: 8px; }
        }
    </style>
</head>
<body class="sf-page">
<div class="bg"></div>

<nav class="topnav">
    <a href="/" class="brand">
        <img src="/dbp-logo.png" alt="DBP" />
        <span class="brand-text">Digital Business Card</span>
    </a>
</nav>

<div class="wrap">

    <!-- Profile — NO EmpId shown (centered across the top) -->
    <div class="profile">
        @* No picture at all when the user chose "No Image" (or hid the photo) — only info is shown *@
        @if (Model.ShowPhoto && !string.IsNullOrWhiteSpace(Model.Photo))
        {
            <div>
                @if (Model.Photo.StartsWith("data:"))
                { <img src="@Model.Photo" alt="@Model.Name" class="profile-photo" /> }
                else if (Model.Photo == "avatar:male")
                { <div class="profile-photo-placeholder"><img src="/dbp-boy.png" alt="Male" style="width:100%;height:100%;object-fit:cover;" /></div> }
                else if (Model.Photo == "avatar:female")
                { <div class="profile-photo-placeholder"><img src="/dbp-girl.png" alt="Female" style="width:100%;height:100%;object-fit:cover;" /></div> }
            </div>
        }
        <p class="profile-name">@Model.Name</p>
        @if (!string.IsNullOrWhiteSpace(Model.Title))
        { <p class="profile-title-pill">@Model.Title</p> }
    </div>

  <div class="qr-layout" id="qrLayout">
   <div class="qr-col-left">
    <!-- QR Code -->
    <div class="qr-card">
        @* Two kinds of QR:
           Open Card    = a link to the online card (always up to date, counts views, shows the photo)
           Save Contact = the contact details are inside the QR itself, so a phone saves the
                          contact even with no internet / no access to this site *@
        <button type="button" class="qr-secret" id="qrSecret" tabindex="-1" aria-hidden="true" onclick="toggleQrTypes()"></button>
        <div class="qr-type advanced" role="tablist" aria-label="QR code type">
            <button type="button" class="qr-type-btn@(contactDefault ? "" : " active")" id="qrTypeCard" role="tab" aria-selected="@(contactDefault ? "false" : "true")" onclick="setQrType('card')">
                <i class="fa-solid fa-id-card"></i> Open Card
            </button>
            <button type="button" class="qr-type-btn@(contactDefault ? " active" : "")" id="qrTypeContact" role="tab" aria-selected="@(contactDefault ? "true" : "false")" onclick="setQrType('contact')">
                <i class="fa-solid fa-address-book"></i> Save Contact
            </button>
        </div>
        <div class="qr-frame" id="qrFrameWrap">
            <img src="@(contactDefault ? "/QR/Contact/" : "/QR/Generate/")@Model.CardToken" alt="@(contactDefault ? "Save Contact QR Code" : "QR Code")" id="qrImg" crossorigin="anonymous" />
        </div>
        <p class="qr-instruction"><i class="fa-solid fa-camera" style="margin-right:6px;opacity:0.7;"></i>Scan with your phone camera</p>
        <p class="qr-sub" id="qrSub">@(contactDefault ? $"to save {Model.Name} to the phone's contacts" : $"to view {Model.Name}'s digital business card")</p>
        <p class="qr-note" id="qrNote"@(contactDefault ? Html.Raw(" style=\"display:block\"") : Html.Raw(""))>Works without internet. If you change your details later, save and share this QR again.</p>
        <button class="btn-save-qr" id="saveQrBtn" onclick="saveQr()" style="margin-top:14px;width:100%;">
            <i class="fa-solid fa-download"></i> Save QR Code
        </button>
    </div>

   </div><!-- /.qr-col-left -->
   <div class="qr-col-right">
    <!-- Access -->
    <div class="link-section advanced">
        <div class="divider-row"><span>OR ACCESS DIRECTLY</span></div>
        <div class="access-row">
            <a href="@cardUrl" class="btn btn-open" target="_blank" rel="noopener">
                <i class="fa-solid fa-id-card"></i> Open Card
            </a>
            <button class="btn btn-copy" id="copyBtn" onclick="copyLink()">
                <i class="fa-solid fa-copy"></i> Copy Link
            </button>
        </div>
    </div>

    <!-- Share via -->
    <div class="share-section advanced">
        <div class="divider-row"><span>SHARE VIA</span></div>
        <div class="share-row">
            <a id="teamsBtn" href="#" class="btn btn-teams" target="_blank" rel="noopener">
                <i class="fa-brands fa-microsoft"></i> Teams
            </a>
            <a id="outlookBtn" href="#" class="btn btn-outlook">
                <i class="fa-solid fa-envelope"></i> Outlook
            </a>
        </div>
    </div>

    <div class="section-line advanced" role="separator"></div>
    <!-- Pending approval banner — shown only when employee has changes awaiting review -->
    @if (Model.HasPending)
    {
        <div style="background:rgba(245,158,11,0.15);border:1px solid rgba(245,158,11,0.4);border-radius:12px;padding:12px 16px;margin-bottom:12px;display:flex;align-items:flex-start;gap:10px;">
            <span style="font-size:18px;flex-shrink:0;">⏳</span>
            <div>
                <p style="color:#fbbf24;font-size:13px;font-weight:800;margin-bottom:2px;">Changes Pending Admin Approval</p>
                <p style="color:rgba(255,255,255,0.5);font-size:11px;line-height:1.5;">
                    Your Title, Department, Organization, or Office changes are awaiting review.
                    Your card currently shows the previously approved information.
                    @if (Model.PendingSubmittedAt.HasValue)
                    { <text>Submitted @Model.PendingSubmittedAt.Value.ToString("MMM d, yyyy").</text> }
                </p>
            </div>
        </div>
    }
    @if (TempData["PendingSubmitted"] != null)
    {
        <div style="background:rgba(245,158,11,0.15);border:1px solid rgba(245,158,11,0.4);border-radius:12px;padding:12px 16px;margin-bottom:12px;">
            <p style="color:#fbbf24;font-size:13px;font-weight:800;">✅ Changes submitted for admin review</p>
            <p style="color:rgba(255,255,255,0.5);font-size:11px;margin-top:2px;">Your Title / Department / Organization / Office changes have been sent to the admin for approval. Other changes were saved immediately.</p>
        </div>
    }
    @if (TempData["Reset"] != null)
    {
        <div style="background:rgba(22,163,74,0.15);border:1px solid rgba(22,163,74,0.4);border-radius:12px;padding:12px 16px;margin-bottom:12px;">
            <p style="color:#4ade80;font-size:13px;font-weight:800;">✅ Card has been reset</p>
            <p style="color:rgba(255,255,255,0.5);font-size:11px;margin-top:2px;">All card information has been cleared. Click Edit to set up your card again.</p>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div style="background:rgba(220,38,38,0.15);border:1px solid rgba(220,38,38,0.4);border-radius:12px;padding:12px 16px;margin-bottom:12px;">
            <p style="color:#fca5a5;font-size:13px;font-weight:700;">⚠️ @TempData["Error"]</p>
        </div>
    }

    <!-- Owner actions — Stats opens inline panel, no separate page -->
    <div class="owner-row">
        <a href="/me/edit" class="btn btn-edit">
            <i class="fa-solid fa-pen-to-square"></i> Edit
        </a>
        <button class="btn btn-edit" onclick="openStats()">
            <i class="fa-solid fa-chart-line"></i> Stats
        </button>
        <form method="post" action="/me/reset" style="flex:1;display:flex;" id="resetForm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="pin" id="resetPinHidden" value="" />
            <button type="button" class="btn btn-reset" style="width:100%;" onclick="openResetModal()">
                <i class="fa-solid fa-rotate-left"></i> Reset
            </button>
        </form>
    </div>

    <!-- Reset confirmation modal -->
    <div id="resetModalOverlay" onclick="closeResetModal()" style="display:none;position:fixed;inset:0;z-index:200;background:rgba(0,0,0,0.6);backdrop-filter:blur(4px);align-items:center;justify-content:center;">
        <div onclick="event.stopPropagation()" style="background:#1e293b;border:1px solid #334155;border-radius:20px;padding:28px 24px;max-width:360px;width:90%;box-shadow:0 20px 60px rgba(0,0,0,0.5);">
            <h3 style="color:#f1f5f9;font-size:16px;font-weight:800;margin-bottom:8px;">⚠️ Reset Card</h3>
            <p style="color:#94a3b8;font-size:13px;margin-bottom:20px;line-height:1.5;">
                This will clear all your card information. This cannot be undone.
                @if (!string.IsNullOrWhiteSpace(Model.CardPin))
                { <text><br/><br/>Enter your PIN to confirm.</text> }
            </p>
            @if (!string.IsNullOrWhiteSpace(Model.CardPin))
            {
                <input type="password" id="resetPinInput" placeholder="Enter PIN"
                       maxlength="6" inputmode="numeric" autocomplete="off"
                       style="width:100%;padding:11px 14px;border:1.5px solid #334155;border-radius:10px;background:#0f172a;color:#f1f5f9;font-size:15px;outline:none;margin-bottom:14px;text-align:center;letter-spacing:2px;"
                       oninput="this.value=this.value.replace(/[^0-9]/g,'')"
                       onfocus="this.style.borderColor='#60a5fa'" onblur="this.style.borderColor='#334155'"
                       onkeydown="if(event.key==='Enter') submitReset();" />
            }
            <div style="display:flex;gap:10px;">
                <button onclick="closeResetModal()" style="flex:1;padding:11px;border:1.5px solid #334155;border-radius:10px;background:transparent;color:#94a3b8;font-size:13px;font-weight:700;cursor:pointer;">
                    Cancel
                </button>
                <button onclick="submitReset()" style="flex:1;padding:11px;border:none;border-radius:10px;background:#dc2626;color:#fff;font-size:13px;font-weight:700;cursor:pointer;">
                    <i class="fa-solid fa-rotate-left"></i> Reset Card
                </button>
            </div>
        </div>
    </div>

    <!-- Publish button -->
    <div class="advanced" style="margin-top:10px;">
        @if (Model.IsActive && !string.IsNullOrWhiteSpace(Model.Name))
        {
            <form method="post" action="/me/publish">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-publish" style="width:100%;"
                        onclick="return confirm('Publish your card? It will be accessible at your public URL.')">
                    <i class="fa-solid fa-globe"></i> @(Model.IsPublished ? "Re-Publish (Update Public Card)" : "Publish Card")
                </button>
            </form>
        }
        else if (!Model.IsActive)
        {
            <button class="btn" disabled style="width:100%;background:#334155;border-color:#334155;opacity:0.5;cursor:not-allowed;">
                <i class="fa-solid fa-ban"></i> Card is Inactive — Cannot Publish
            </button>
            <p style="text-align:center;color:#fca5a5;font-size:11px;margin-top:6px;">
                ⚠️ Activate your card first before publishing.
            </p>
        }
        else
        {
            <button class="btn" disabled style="width:100%;background:#334155;border-color:#334155;opacity:0.5;cursor:not-allowed;">
                <i class="fa-solid fa-ban"></i> No Content — Cannot Publish
            </button>
            <p style="text-align:center;color:#fca5a5;font-size:11px;margin-top:6px;">
                ⚠️ Fill in your card details first before publishing.
            </p>
        }
        @if (Model.IsPublished && TempData["Published"] != null)
        {
            <div style="margin-top:8px;background:rgba(5,150,105,0.15);border:1px solid rgba(5,150,105,0.3);border-radius:10px;padding:10px 14px;font-size:12px;color:#6ee7b7;word-break:break-all;">
                ✅ Published: <a href="@TempData["Published"]" target="_blank" style="color:#34d399;">@TempData["Published"]</a>
            </div>
        }
        @if (Model.IsPublished && TempData["Published"] == null)
        {
            <p style="text-align:center;color:rgba(255,255,255,0.35);font-size:11px;margin-top:6px;">
                ✅ Card is published — edit and re-publish to update
            </p>
        }
    </div>
   </div><!-- /.qr-col-right -->
  </div><!-- /.qr-layout -->
</div>

<!-- ── Inline Stats Panel ── -->
<div class="stats-panel" id="statsPanel">
    <div class="stats-header">
        <h2><i class="fa-solid fa-chart-line" style="margin-right:8px;color:#60a5fa;"></i>Card Stats</h2>
        <button class="stats-close" onclick="closeStats()">
            <i class="fa-solid fa-xmark"></i> Close
        </button>
    </div>
    <div class="stats-body">
      <div class="stats-col stats-col-left">

        <!-- View counts -->
        <div class="section-head">
            <p class="stats-section-title">Overview</p>
            <button type="button" class="toggle-btn" data-target="countsSection" aria-controls="countsSection" aria-expanded="true">
                <i class="fa-solid fa-eye-slash"></i><span>Hide</span>
            </button>
        </div>
        <div class="stats-grid" id="countsSection">
            <div class="stat-box total">
                <div class="stat-num" id="statTotal">@totalViews</div>
                <div class="stat-lbl">Total Views</div>
            </div>
            <div class="stat-box">
                <div class="stat-num" id="statToday">@todayViews</div>
                <div class="stat-lbl">Today</div>
            </div>
            <div class="stat-box">
                <div class="stat-num" id="statWeek">@weekViews</div>
                <div class="stat-lbl">Last 7 Days</div>
            </div>
        </div>

        <!-- Bar chart -->
        @if (Model.ViewHistory != null && Model.ViewHistory.Count > 0)
        {
            <div class="section-head">
                <p class="stats-section-title">Daily Views (Last 14 Days)</p>
                <button type="button" class="toggle-btn" data-target="chartSection" aria-controls="chartSection" aria-expanded="true">
                    <i class="fa-solid fa-eye-slash"></i><span>Hide</span>
                </button>
            </div>
            var recent = Model.ViewHistory.OrderByDescending(v => v.Date).Take(14).Reverse().ToList();
            var maxCount = recent.Max(v => v.Count);
            <div class="chart-wrap" id="chartSection">
                @foreach (var day in recent)
                {
                    var pct = maxCount > 0 ? (int)((double)day.Count / maxCount * 100) : 0;
                    var label = DateTime.TryParse(day.Date, out var dt) ? dt.ToString("MMM d") : day.Date;
                    <div class="chart-row">
                        <span class="chart-date">@label</span>
                        <div class="chart-track"><div class="chart-fill" style="width:@(pct)%"></div></div>
                        <span class="chart-count">@day.Count</span>
                    </div>
                }
            </div>
        }

      </div><!-- /.stats-col-left -->

      <div class="stats-col stats-col-right">
        <!-- Audit log -->
        <div class="section-head">
            <p class="stats-section-title">Audit Log</p>
            <button type="button" class="toggle-btn" data-target="auditSection" aria-controls="auditSection" aria-expanded="true">
                <i class="fa-solid fa-eye-slash"></i><span>Hide</span>
            </button>
        </div>
        <div id="auditSection">
        <div class="audit-card" id="auditCard">
            @if (Model.AuditLog == null || !Model.AuditLog.Any())
            {
                <p class="empty">No activity yet.</p>
            }
            else
            {
                @foreach (var entry in Model.AuditLog)
                {
                    var dotClass = entry.Action?.ToLower() switch {
                        "created"  => "created",
                        "reset"    => "reset",
                        _          => "updated"
                    };
                    <div class="audit-row">
                        <div class="audit-dot @dotClass"></div>
                        <div>
                            @{
                                var auditPht = TimeZoneInfo.ConvertTimeFromUtc(
                                    DateTime.SpecifyKind(entry.Timestamp, DateTimeKind.Utc),
                                    TimeZoneInfo.GetSystemTimeZones()
                                        .FirstOrDefault(z => z.Id == "Asia/Manila" || z.Id == "Singapore Standard Time")
                                    ?? TimeZoneInfo.Utc);
                            }
                            <p class="audit-action">@entry.Action</p>
                            <p class="audit-detail">@entry.Detail</p>
                            <p class="audit-time"><i class="fa-regular fa-clock" style="margin-right:3px;"></i>@auditPht.ToString("MMM d, yyyy h:mm tt") PHT</p>
                        </div>
                    </div>
                }
            }
        </div>
        <div class="pager" id="auditPager" style="display:none;">
            <button type="button" class="pager-btn" id="auditPrev">&lsaquo; Previous</button>
            <span class="pager-lbl" id="auditPageLbl" aria-live="polite"></span>
            <button type="button" class="pager-btn" id="auditNext">Next &rsaquo;</button>
        </div>
        </div><!-- /#auditSection -->
      </div><!-- /.stats-col-right -->
    </div>
</div>

<script>
    var cardUrl = @Json.Serialize(cardUrl);
    var empId   = @Json.Serialize(empId);
    var empName = @Json.Serialize(Model.Name);
    var qrToken = @Json.Serialize(Model.CardToken);

    // Teams & Outlook
    (function() {
        var msg = encodeURIComponent('Hi! Here is my DBP Digital Business Card: ' + cardUrl);
        document.getElementById('teamsBtn').href = 'https://teams.microsoft.com/l/chat/0/0?message=' + msg;
        var subject = encodeURIComponent('My DBP Digital Business Card – ' + empName);
        var body    = encodeURIComponent('Hi,\n\nHere is my DBP Digital Business Card:\n\n' + cardUrl + '\n\nBest regards,\n' + empName);
        document.getElementById('outlookBtn').href = 'mailto:?subject=' + subject + '&body=' + body;
    })();

    function openStats() {
        document.getElementById('statsPanel').classList.add('open');
        window.scrollTo(0,0);
        auditPage = 1;
        requestAnimationFrame(layoutAudit);   // measure once the panel is on screen
        // Fetch live stats so numbers are always fresh
        fetch('/api/me/stats', { credentials: 'include' })
            .then(function(r){ return r.ok ? r.json() : null; })
            .then(function(d){
                if (!d) return;
                var t = document.getElementById('statTotal');
                var td= document.getElementById('statToday');
                var w = document.getElementById('statWeek');
                if (t)  t.textContent  = d.total;
                if (td) td.textContent = d.today;
                if (w)  w.textContent  = d.week;
            })
            .catch(function(){});
    }
    function closeStats() { document.getElementById('statsPanel').classList.remove('open'); }

    // Hide / Show for each stats section
    document.querySelectorAll('.toggle-btn').forEach(function (btn) {
        btn.addEventListener('click', function () {
            var target = document.getElementById(btn.getAttribute('data-target'));
            if (!target) return;
            var hide = !target.classList.contains('is-collapsed');
            target.classList.toggle('is-collapsed', hide);
            btn.setAttribute('aria-expanded', hide ? 'false' : 'true');
            btn.querySelector('span').textContent = hide ? 'Show' : 'Hide';
            btn.querySelector('i').className = hide ? 'fa-solid fa-eye' : 'fa-solid fa-eye-slash';
            layoutAudit();   // hiding/showing a section changes how much room the audit log has
        });
    });

    // Audit log: no scrolling. Show as many entries as fit in the space left on screen,
    // and page through the rest with Previous / Next.
    var auditPage = 1, auditPages = 1;
    function layoutAudit() {
        var panel = document.getElementById('statsPanel');
        var card  = document.getElementById('auditCard');
        var pager = document.getElementById('auditPager');
        var section = document.getElementById('auditSection');
        if (!panel || !card || !pager || !panel.classList.contains('open')) return;
        if (section && section.classList.contains('is-collapsed')) return;

        var rows = Array.prototype.slice.call(card.querySelectorAll('.audit-row'));
        if (rows.length === 0) { pager.style.display = 'none'; return; }

        // Measure with every row visible and the pager reserved, then count what fits
        rows.forEach(function (r) { r.style.display = ''; });
        pager.style.display = 'flex';
        var cs    = getComputedStyle(card);
        var avail = card.clientHeight - parseFloat(cs.paddingTop) - parseFloat(cs.paddingBottom);
        var total = rows.reduce(function (sum, r) { return sum + r.offsetHeight; }, 0);
        var rowH  = total / rows.length;
        var size  = Math.max(1, Math.floor(avail / rowH));

        auditPages = Math.max(1, Math.ceil(rows.length / size));
        if (auditPage > auditPages) auditPage = auditPages;
        renderAudit(rows, size);
    }
    function renderAudit(rows, size) {
        rows.forEach(function (r, i) {
            r.style.display = (i >= (auditPage - 1) * size && i < auditPage * size) ? '' : 'none';
        });
        document.getElementById('auditPageLbl').textContent = 'Page ' + auditPage + ' of ' + auditPages;
        document.getElementById('auditPrev').disabled = auditPage <= 1;
        document.getElementById('auditNext').disabled = auditPage >= auditPages;
        document.getElementById('auditPager').style.display = auditPages > 1 ? 'flex' : 'none';
    }
    document.getElementById('auditPrev').addEventListener('click', function () { if (auditPage > 1)          { auditPage--; layoutAudit(); } });
    document.getElementById('auditNext').addEventListener('click', function () { if (auditPage < auditPages) { auditPage++; layoutAudit(); } });
    window.addEventListener('resize', layoutAudit);

    function openResetModal() {
        document.getElementById('resetModalOverlay').style.display = 'flex';
        var pin = document.getElementById('resetPinInput');
        if (pin) { pin.value = ''; setTimeout(function(){ pin.focus(); }, 100); }
    }
    function closeResetModal() {
        document.getElementById('resetModalOverlay').style.display = 'none';
    }
    function submitReset() {
        var pinInput = document.getElementById('resetPinInput');
        var hidden   = document.getElementById('resetPinHidden');
        if (pinInput && hidden) hidden.value = pinInput.value || '';
        closeResetModal();
        document.getElementById('resetForm').submit();
    }

    function copyLink() {
        navigator.clipboard.writeText(cardUrl).then(function() {
            var btn = document.getElementById('copyBtn');
            btn.innerHTML = '<i class="fa-solid fa-check"></i> Copied!';
            btn.style.background = 'rgba(22,163,74,0.6)';
            setTimeout(function() { btn.innerHTML = '<i class="fa-solid fa-copy"></i> Copy Link'; btn.style.background = ''; }, 2000);
        }).catch(function() {
            var el = document.createElement('textarea');
            el.value = cardUrl; document.body.appendChild(el); el.select(); document.execCommand('copy'); document.body.removeChild(el);
        });
    }

    // Which QR is shown: 'card' (link to the online card) or 'contact' (contact details inside the QR)
    var qrDefault = @Json.Serialize(contactDefault ? "contact" : "card");
    var qrType = qrDefault;
    function qrSrc() { return (qrType === 'contact' ? '/QR/Contact/' : '/QR/Generate/') + qrToken; }
    function setQrType(type) {
        qrType = type === 'contact' ? 'contact' : 'card';
        var isContact = qrType === 'contact';
        document.getElementById('qrImg').src = qrSrc();
        document.getElementById('qrImg').alt = isContact ? 'Save Contact QR Code' : 'QR Code';
        document.getElementById('qrSub').textContent = isContact
            ? "to save " + empName + " to the phone's contacts"
            : "to view " + empName + "'s digital business card";
        document.getElementById('qrNote').style.display = isContact ? 'block' : 'none';
        var c = document.getElementById('qrTypeCard'), k = document.getElementById('qrTypeContact');
        c.classList.toggle('active', !isContact); c.setAttribute('aria-selected', String(!isContact));
        k.classList.toggle('active', isContact);  k.setAttribute('aria-selected', String(isContact));
    }

    // Hidden button: shows/hides the hidden parts (QR switch, Open Card, Copy Link, Share via, Publish). Hiding them goes back to the default QR.
    function toggleQrTypes() {
        var shown = document.getElementById('qrLayout').classList.toggle('show-advanced');
        if (!shown) setQrType(qrDefault);
    }

    function saveQr() {
        var btn = document.getElementById('saveQrBtn');
        btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Saving...';
        btn.disabled = true;
        fetch(qrSrc())
            .then(function(r) { if (!r.ok) throw new Error('QR'); return r.blob(); })
            .then(function(blob) {
                var url = URL.createObjectURL(blob);
                var a = document.createElement('a');
                a.href = url; a.download = empName.replace(/\s+/g,'-') + (qrType === 'contact' ? '-Contact-QR.png' : '-QR.png');
                document.body.appendChild(a); a.click(); document.body.removeChild(a); URL.revokeObjectURL(url);
                btn.innerHTML = '<i class="fa-solid fa-check"></i> QR Saved!';
                setTimeout(function() { btn.innerHTML = '<i class="fa-solid fa-download"></i> Save QR Code'; btn.disabled = false; }, 2500);
            })
            .catch(function() { window.open(qrSrc(), '_blank'); btn.innerHTML = '<i class="fa-solid fa-download"></i> Save QR Code'; btn.disabled = false; });
    }
</script>
@await Html.PartialAsync("_SiteFooter")
</body>
</html>
