@inject Microsoft.Extensions.Configuration.IConfiguration Config
@{
    Layout = null;
    string privacyUrl = Config["Footer:PrivacyUrl"] ?? "https://www.dbp.ph/dbp-data-privacy-notice/";
    string helpUrl    = Config["Footer:HelpUrl"]    ?? "https://www.dbp.ph/contact-us/";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>DBP - Terms of Use</title>
    <link rel="icon" type="image/png" href="/dbp-icon.png" />
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
        body { font-family: Arial, sans-serif; min-height: 100vh; display: flex; flex-direction: column; align-items: center; padding: 28px 20px 0; }
        .bg { position: fixed; inset: 0; z-index: -1; background: linear-gradient(155deg, rgba(10,25,70,0.95) 0%, rgba(30,64,175,0.90) 45%, rgba(15,40,100,0.97) 100%), url('/bg.png') center/cover no-repeat; }
        .page { width: 100%; max-width: 760px; background: #fff; border-radius: 20px; border-top: 5px solid #2563eb; box-shadow: 0 16px 48px rgba(0,0,0,0.35); padding: 30px clamp(20px, 4vw, 40px) 26px; }
        .logo { display: block; width: 56px; margin: 0 auto 10px; }
        h1 { text-align: center; color: #0f172a; font-size: 24px; font-weight: 800; }
        .sub { text-align: center; color: #374151; font-size: 14px; margin: 4px 0 22px; }
        h2 { color: #1d4ed8; font-size: 13px; font-weight: 800; letter-spacing: 1px; text-transform: uppercase; margin: 20px 0 6px; }
        p, li { color: #111827; font-size: 15px; line-height: 1.65; }
        ul { padding-left: 22px; }
        li { margin-bottom: 4px; }
        strong { font-weight: 800; }
        a { color: #1d4ed8; }
        .back { display: inline-block; margin-top: 24px; color: #1d4ed8; font-size: 15px; font-weight: 700; text-decoration: none; }
        .back:hover, .back:focus-visible { text-decoration: underline; }

    </style>
</head>
<body>
<div class="bg"></div>
<main class="page">
    <img src="/dbp-logo.png" alt="DBP" class="logo" />
    <h1>Terms of Use</h1>
    <p class="sub">DBP Digital Business Card System</p>

    <h2>Who may use this system</h2>
    <p>This system is for authorized employees of the Development Bank of the Philippines only.</p>

    <h2>Accuracy of your information</h2>
    <p>
        You must make sure that the information on your digital business card is accurate and authorized.
        Falsification or unauthorized alteration of official information, including names and positions, is strictly prohibited.
    </p>

    <h2>Logging and auditing</h2>
    <p>All system activities and changes may be logged and audited.</p>

    <h2>Consequences of misuse</h2>
    <p>
        Violations may result in disciplinary action, including termination, and civil or criminal liability where applicable,
        under <strong>Article 297 of the Labor Code, Articles 171&ndash;172 of the Revised Penal Code, and Articles 19&ndash;21 of the Civil Code of the Philippines</strong>.
    </p>

    <h2>Your card PIN (optional)</h2>
    <p>
        Using a PIN is your choice. If you turn it on, keep your PIN private and do not share it with anyone.
    </p>

    <h2>Your acknowledgement</h2>
    <p>
        By logging in, you acknowledge your responsibility for the accuracy of your information and your compliance with company policies and applicable laws.
    </p>

    <h2>Privacy and help</h2>
    <ul>
        <li>How DBP handles personal data: <a href="@privacyUrl" target="_blank" rel="noopener noreferrer">Privacy Policy</a></li>
        <li>Questions or problems: <a href="@helpUrl" target="_blank" rel="noopener noreferrer">Help &amp; Support</a></li>
    </ul>

    <a href="/" class="back">&larr; Back to Home</a>
</main>
@await Html.PartialAsync("_SiteFooter")
</body>
</html>
