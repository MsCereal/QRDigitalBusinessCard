@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>e-Ugnay – DBP Digital Business Card</title>
    <link rel="icon" type="image/png" href="/dbp-icon.png" />
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            font-family: Arial, sans-serif;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            justify-content: flex-start;
            align-items: center;
            padding: 40px 24px 60px;
            position: relative;
            overflow-y: auto;
            overflow-x: hidden;
        }

        /* ── Background: image with blue gradient overlay ── */
        .bg {
            position: fixed;
            inset: 0;
            z-index: 0;

            /* Fallback gradient if no bg.jpg */
            background:
                linear-gradient(
                    155deg,
                    rgba(10, 25, 70, 0.92) 0%,
                    rgba(30, 64, 175, 0.88) 45%,
                    rgba(15, 40, 100, 0.95) 100%
                ),
                url('/bg.png') center/cover no-repeat;
        }

        /* Subtle radial glow for depth */
        .bg::after {
            content: '';
            position: absolute;
            inset: 0;
            background: radial-gradient(ellipse 80% 60% at 50% 40%,
                rgba(37, 99, 235, 0.25) 0%,
                transparent 70%);
        }

        /* ── Content ── */
        .content {
            position: relative;
            z-index: 1;
            text-align: center;
            max-width: 420px;
            width: 100%;
        }

        /* Logo */
        .logo-wrap {
            margin-bottom: 28px;
        }
        .logo-wrap img {
            width: 90px;
            height: 90px;
            object-fit: contain;
            filter: drop-shadow(0 6px 20px rgba(0,0,0,0.4));
        }

        /* Heading */
        .tagline {
            color: rgba(255,255,255,0.55);
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 3px;
            text-transform: uppercase;
            margin-bottom: 12px;
        }

        h1 {
            color: #ffffff;
            font-size: 28px;
            font-weight: 800;
            line-height: 1.2;
            margin-bottom: 6px;
            text-shadow: 0 2px 12px rgba(0,0,0,0.3);
        }

        h1 span {
            color: #93c5fd; /* light blue accent */
        }

        /* Montserrat Bold (SIL Open Font License), hosted in the app so no outside request is needed */
        @@font-face {
            font-family: "Montserrat";
            font-weight: 700;
            font-style: normal;
            font-display: swap;
            src: url("/fonts/montserrat-700.woff2") format("woff2");
        }

        /* e-Ugnay and the motto: same font, same weight, all white */
        h1.brand, .motto {
            font-family: "Montserrat", "Segoe UI", Arial, sans-serif;
            font-weight: 700;
            color: #ffffff;
            text-shadow: 0 2px 12px rgba(0,0,0,0.3);
        }
        h1.brand span { color: #ffffff; }

        h1.brand {
            font-size: 52px;
            letter-spacing: 0;
            margin-bottom: 8px;
        }

        .motto {
            font-size: 18px;
            letter-spacing: 0;
            margin-bottom: 28px;
        }

        .lead-title {
            color: #ffffff;
            font-size: 22px;
            font-weight: 700;
            margin-bottom: 8px;
        }

        .subtitle { margin-bottom: 28px; color: rgba(255,255,255,0.85); font-size: 15px; }

        .steps-title {
            color: #ffffff;
            font-size: 15px;
            font-weight: 700;
            letter-spacing: 1px;
            text-transform: uppercase;
            text-align: center;
        }

        .subtitle {
            color: rgba(255,255,255,0.6);
            font-size: 14px;
            line-height: 1.6;
            margin-bottom: 40px;
        }

        /* Divider line */
        .rule {
            width: 48px;
            height: 3px;
            background: linear-gradient(90deg, #2563eb, #60a5fa);
            border-radius: 2px;
            margin: 0 auto 36px;
        }

        /* Steps — hidden by default, shown on CTA click */
        .steps {
            display: flex;
            flex-direction: column;
            gap: 12px;
            margin-bottom: 36px;
            text-align: left;
            overflow: hidden;
            max-height: 0;
            opacity: 0;
            transition: max-height 0.5s ease, opacity 0.4s ease, margin-bottom 0.4s ease;
        }
        .steps.visible {
            max-height: 560px;
            opacity: 1;
            margin-bottom: 36px;
        }
        .step {
            display: flex;
            align-items: flex-start;
            gap: 14px;
            background: rgba(255,255,255,0.06);
            border: 1px solid rgba(255,255,255,0.1);
            border-radius: 14px;
            padding: 14px 16px;
            backdrop-filter: blur(4px);
        }
        .step-num {
            width: 28px;
            height: 28px;
            border-radius: 50%;
            background: #2563eb;
            color: #fff;
            font-size: 13px;
            font-weight: 800;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            margin-top: 1px;
        }
        .step-text strong {
            display: block;
            color: #f1f5f9;
            font-size: 13px;
            font-weight: 700;
            margin-bottom: 2px;
        }
        .step-text span {
            color: rgba(255,255,255,0.5);
            font-size: 12px;
        }

        /* CTA Button */
        .cta {
            display: block;
            width: 100%;
            padding: 16px 24px;
            background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);
            color: #fff;
            font-size: 16px;
            font-weight: 800;
            border: none;
            border-radius: 14px;
            text-decoration: none;
            cursor: pointer;
            letter-spacing: 0.5px;
            box-shadow: 0 8px 24px rgba(37, 99, 235, 0.45);
            transition: transform 0.12s, box-shadow 0.12s;
            margin-bottom: 14px;
        }
        .cta:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 30px rgba(37, 99, 235, 0.55);
        }
        .cta:active { transform: scale(0.98); }

        /* Already have a card link */
        .existing-link {
            color: rgba(255,255,255,0.45);
            font-size: 13px;
            text-decoration: none;
            display: block;
            margin-bottom: 40px;
        }
        .existing-link:hover { color: rgba(255,255,255,0.7); }

        /* Already have ID form */
        .lookup-box {
            background: rgba(255,255,255,0.06);
            border: 1px solid rgba(255,255,255,0.12);
            border-radius: 14px;
            padding: 18px 16px;
            backdrop-filter: blur(4px);
        }
        .lookup-box p {
            color: rgba(255,255,255,0.5);
            font-size: 12px;
            letter-spacing: 0.5px;
            margin-bottom: 10px;
            text-transform: uppercase;
            font-weight: 700;
        }
        .lookup-row {
            display: flex;
            gap: 8px;
        }
        .lookup-row input {
            flex: 1;
            padding: 11px 14px;
            border: 1.5px solid rgba(255,255,255,0.15);
            border-radius: 10px;
            background: rgba(255,255,255,0.08);
            color: #fff;
            font-size: 14px;
            outline: none;
            transition: border-color 0.15s;
        }
        .lookup-row input::placeholder { color: rgba(255,255,255,0.3); }
        .lookup-row input:focus { border-color: #60a5fa; }
        .lookup-row button {
            padding: 11px 18px;
            background: rgba(255,255,255,0.12);
            border: 1.5px solid rgba(255,255,255,0.2);
            border-radius: 10px;
            color: #fff;
            font-size: 13px;
            font-weight: 700;
            cursor: pointer;
            white-space: nowrap;
            transition: background 0.15s;
        }
        .lookup-row button:hover { background: rgba(255,255,255,0.2); }

        .lookup-error {
            color: #fca5a5;
            font-size: 12px;
            margin-top: 8px;
            display: none;
        }

        /* Footer */
        .footer-note {
            color: rgba(255,255,255,0.25);
            font-size: 11px;
            margin-top: 32px;
            letter-spacing: 0.5px;
        }

        /* ── Restricted access legal banner (top) ── */
        .legal-banner {
            position: relative;
            z-index: 1;
            /* Compact + fluid: ~55% of the viewport, 300px–720px */
            width: clamp(min(100%, 300px), 55vw, 720px);
            max-width: 100%;
            margin: 0 auto 24px;
            padding: 12px 40px 12px 16px;
            text-align: left;
            /* Fade in/out (space stays reserved so the page does not jump) */
            opacity: 1;
            transition: opacity 0.5s ease;
            /* Light translucent red — same look as the Sign In page notice */
            background: rgba(220, 38, 38, 0.18);
            border: 1px solid rgba(248, 113, 113, 0.35);
            border-radius: 14px;
            backdrop-filter: blur(6px);
            -webkit-backdrop-filter: blur(6px);
        }
        .legal-banner .legal-title {
            color: #fca5a5;
            font-size: 12px;
            font-weight: 800;
            letter-spacing: 0.5px;
            text-transform: uppercase;
            margin-bottom: 10px;
            display: flex;
            align-items: center;
            gap: 7px;
        }
        .legal-banner p {
            color: #ffffff;
            font-size: 12px;
            line-height: 1.7;
            margin-bottom: 9px;
        }
        .legal-banner p:last-child { margin-bottom: 0; }
        .legal-banner strong { color: #fde68a; font-weight: 800; }

        /* Smaller text */
        .legal-banner .legal-title { font-size: 11px; margin-bottom: 7px; }
        .legal-banner p            { font-size: 11px; line-height: 1.55; margin-bottom: 6px; }

        /* Fade states */
        .legal-banner.is-hidden { opacity: 0; pointer-events: none; }
        .legal-banner.is-closed { display: none; }

        /* Close (X) button */
        .legal-close {
            position: absolute;
            top: 8px;
            right: 8px;
            width: 26px;
            height: 26px;
            border: none;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.12);
            color: #ffffff;
            font-size: 16px;
            line-height: 1;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: background 0.15s;
        }
        .legal-close:hover,
        .legal-close:focus-visible { background: rgba(255, 255, 255, 0.28); outline: none; }

        @@media (prefers-reduced-motion: reduce) {
            .legal-banner { transition: none; }
        }

        /* Phones / narrow screens: full width */
        @@media (max-width: 600px) {
            .legal-banner {
                width: 100%;
                margin-bottom: 20px;
                border-radius: 12px;
            }
        }
    </style>
</head>
<body class="sf-top">

<div class="bg"></div>

<div class="legal-banner" id="legalBanner" role="region" aria-label="Restricted access notice">
    <button type="button" class="legal-close" id="legalClose" aria-label="Close notice" title="Close">&times;</button>
    <div class="legal-title">&#9888; Restricted Access — Authorized Employees Only</div>
    <p>
        All employees must ensure that their digital business card information is accurate and
        authorized. Falsification or unauthorized alteration of official information, including
        names and positions, is strictly prohibited.
    </p>
    <p>
        All system activities and changes may be logged and audited. Violations may result in
        disciplinary action, including termination, and civil or criminal liability where
        applicable, under <strong>Article 297 of the Labor Code, Articles 171–172 of the Revised
        Penal Code, and Articles 19–21 of the Civil Code of the Philippines.</strong>
    </p>
    <p>
        By logging in, you acknowledge your responsibility for the accuracy of your information
        and your compliance with company policies and applicable laws.
    </p>
</div>

<div class="content">

    <div class="logo-wrap">
        <img src="/dbp-logo.png" alt="Development Bank of the Philippines" />
    </div>

    <p class="tagline">Development Bank of the Philippines</p>
    <h1 class="brand">e-<span>Ugnay</span></h1>
    <p class="motto">One Identity. Every Connection.</p>

    <p class="subtitle">Share your professional identity with one unique QR code.</p>

    <div class="rule"></div>

    <div class="steps" id="stepsBlock">
        <div class="steps-title">How It Works</div>
        <div class="step">
            <div class="step-num">1</div>
            <div class="step-text">
                <strong>Enter Your Details</strong>
                <span>Provide your name, position, contact information, and professional links.</span>
            </div>
        </div>
        <div class="step">
            <div class="step-num">2</div>
            <div class="step-text">
                <strong>Generate Your QR Code</strong>
                <span>Get a unique QR code associated with your Employee ID and digital business card.</span>
            </div>
        </div>
        <div class="step">
            <div class="step-num">3</div>
            <div class="step-text">
                <strong>Share Your Digital Card</strong>
                <span>Allow anyone who scans your QR code to view your professional business card.</span>
            </div>
        </div>
    </div>

    <a href="/login" class="cta" id="ctaBtn" onclick="revealSteps(event)">Create My Digital Card</a>

    <!-- Returning employee lookup -->
    <div class="lookup-box">
        <p>Already have a card? Enter your Employee ID</p>
        <div class="lookup-row">
            <input type="text" id="empIdInput" placeholder="e.g. 0000001-DBP"
                   autocomplete="off" maxlength="11" />
            <button id="lookupBtn" onclick="goToCard()">Go →</button>
        </div>
        <p class="lookup-error" id="lookupError">⚠️ No card found for that Employee ID.</p>
    </div>


</div>

<script>
    function revealSteps(e) {
        e.preventDefault();
        var steps = document.getElementById('stepsBlock');
        var btn   = document.getElementById('ctaBtn');
        steps.classList.add('visible');
        btn.textContent = 'Continue →';
        btn.onclick = null;          // next click goes straight to /login
        btn.href = '/login';
        window.scrollTo({ top: document.body.scrollHeight, behavior: 'smooth' });
    }

    function goToCard() {
        var empId = document.getElementById('empIdInput').value.trim();
        var errEl = document.getElementById('lookupError');
        var btn   = document.getElementById('lookupBtn');

        if (!empId) {
            document.getElementById('empIdInput').focus();
            return;
        }

        errEl.style.display = 'none';
        btn.textContent = '...';
        btn.disabled = true;

        fetch('/check/' + encodeURIComponent(empId))
            .then(function(r) { return r.json(); })
            .then(function(data) {
                if (data.exists) {
                    window.location.href = '/qr/' + encodeURIComponent(empId);
                } else {
                    errEl.style.display = 'block';
                    btn.textContent = 'Go →';
                    btn.disabled = false;
                }
            })
            .catch(function() {
                errEl.style.display = 'block';
                btn.textContent = 'Go →';
                btn.disabled = false;
            });
    }

    document.getElementById('empIdInput').addEventListener('keydown', function (e) {
        if (e.key === 'Enter') goToCard();
    });
</script>

<script>
// Restricted-access notice: always shown (no blinking) until the user closes it (X).
// Closing is remembered for this browser session.
(function () {
    var banner = document.getElementById('legalBanner');
    var close  = document.getElementById('legalClose');
    if (!banner || !close) return;

    var KEY = 'dbpLegalClosed';
    try { if (sessionStorage.getItem(KEY) === '1') { banner.classList.add('is-closed'); return; } } catch (e) {}

    close.addEventListener('click', function () {
        banner.classList.add('is-closed');
        try { sessionStorage.setItem(KEY, '1'); } catch (e) {}
    });
})();
</script>

@* The bank name in the copyright keeps the hidden admin entry (/admin/clear) that the old Welcome copyright line had *@
@await Html.PartialAsync("_SiteFooter", null, new ViewDataDictionary(ViewData) { { "AdminEntry", true } })
</body>
</html>
