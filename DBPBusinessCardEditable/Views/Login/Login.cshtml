@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>DBP — Sign In</title>
    <link rel="icon" type="image/png" href="/dbp-icon.png" />
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
        body { font-family: Arial, sans-serif; min-height: 100vh; display: flex; align-items: center;
               justify-content: center; padding: 20px;
               background: linear-gradient(155deg, rgba(10,25,70,0.96) 0%, rgba(30,64,175,0.92) 45%, rgba(15,40,100,0.98) 100%), url('/bg.png') center/cover no-repeat; }
        .box { background: rgba(255,255,255,0.06); backdrop-filter: blur(12px);
               border: 1px solid rgba(255,255,255,0.12); border-radius: 20px;
               padding: 40px 32px; max-width: 380px; width: 100%; text-align: center; }
        .logo { width: 72px; margin-bottom: 16px; }
        .org  { color: rgba(255,255,255,0.5); font-size: 11px; letter-spacing: 1.5px;
                text-transform: uppercase; font-weight: 700; margin-bottom: 8px; }
        h1   { color: #fff; font-size: 24px; font-weight: 800; margin-bottom: 6px; }
        .sub { color: rgba(255,255,255,0.45); font-size: 13px; margin-bottom: 28px; line-height: 1.5; }
        label { display: block; text-align: left; color: rgba(255,255,255,0.6);
                font-size: 11px; font-weight: 700; letter-spacing: 0.5px;
                text-transform: uppercase; margin-bottom: 6px; }
        input[type=text] {
            width: 100%; padding: 13px 16px; background: rgba(255,255,255,0.08);
            border: 1.5px solid rgba(255,255,255,0.15); border-radius: 11px;
            color: #fff; font-size: 15px; font-weight: 700; outline: none;
            letter-spacing: 0.5px; transition: border-color 0.15s;
            margin-bottom: 6px;
        }
        input[type=text]::placeholder { color: rgba(255,255,255,0.25); font-weight: 400; }
        input[type=text]:focus { border-color: #60a5fa; background: rgba(255,255,255,0.12); }
        .hint { color: rgba(255,255,255,0.35); font-size: 11px; text-align: left; margin-bottom: 20px; }
        .btn  { width: 100%; padding: 14px; background: #2563eb; border: none;
                border-radius: 11px; color: #fff; font-size: 15px; font-weight: 800;
                cursor: pointer; transition: background 0.15s; }
        .btn:hover { background: #1d4ed8; }
        .error { background: rgba(220,38,38,0.15); border: 1px solid rgba(220,38,38,0.3);
                 color: #fca5a5; font-size: 13px; border-radius: 9px;
                 padding: 10px 14px; margin-bottom: 18px; text-align: left; }
        .note  { color: rgba(255,255,255,0.25); font-size: 11px; margin-top: 20px; line-height: 1.6; }
    </style>
</head>
<body>
<div class="box">
    <img src="/dbp-logo.png" alt="DBP" class="logo" />
    <p class="org">Development Bank of the Philippines</p>
    <h1>Sign In</h1>
    <p class="sub">Enter your domain username to access your digital business card.</p>

    @if (ViewBag.Error != null)
    {
        <div class="error">&#9888; @ViewBag.Error</div>
    }
    @if (Context.Request.Query["reason"] == "session_expired")
    {
        <div class="error" style="background:rgba(245,158,11,0.15);border-color:rgba(245,158,11,0.4);color:#fbbf24;">
            ⏱️ Your session expired. Please sign in again to continue.
        </div>
    }

    <form method="get" action="/auth/windows" autocomplete="off">
        <label for="username">Domain Username</label>
        <input type="text" id="username" name="username"
               placeholder="e.g. jcruz"
               maxlength="64"
               autocomplete="username"
               spellcheck="false"
               autocorrect="off"
               autocapitalize="off"
               required />
        <p class="hint">Your Windows login name (without DOMAIN\)</p>
        <button type="submit" class="btn">Sign In &#8594;</button>
    </form>

    <p class="note">
        Your Windows session is used to verify your identity.<br/>
        No password is sent to or stored by this application.
    </p>
</div>
</body>
</html>
