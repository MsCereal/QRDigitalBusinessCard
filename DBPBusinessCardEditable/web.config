<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS settings for the eCard site (C:\inetpub\wwwroot\eCard\web.config).
  Values can be adjusted ON THE SERVER. Never put real passwords into this file in git.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath=".\DBPBusinessCardEditable.exe" arguments="" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess">
        <environmentVariables>
          <!-- UAT / test server (turns off developer error pages and Swagger) -->
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Staging" />
          <!-- Card database: ONE SQLite file on this web server (no database server needed).
               Keep it OUTSIDE the app folder so a redeploy never deletes it. Back this folder up regularly. -->
          <environmentVariable name="Database__Path" value="C:\inetpub\eCard_data\bizcard.db" />
          <!-- Folder for published card pages. Keep it OUTSIDE the app folder so a redeploy does not delete it. -->
          <environmentVariable name="Publishing__OutputPath" value="C:\inetpub\eCard_published\" />
          <!-- Address of this site + /published  (change if the site uses a name or another port) -->
          <environmentVariable name="Publishing__PublicBaseUrl" value="http://172.16.64.19/published" />
          <!-- Admin console password. Leave empty to keep the admin console switched off. -->
          <environmentVariable name="ADMIN_KEY" value="" />
        </environmentVariables>
      </aspNetCore>
    </system.webServer>
  </location>
</configuration>
