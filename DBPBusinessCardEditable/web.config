<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS settings for the eCard site. The System Admin edits the values marked CHANGE_ME
  ON THE SERVER ONLY (C:\inetpub\wwwroot\eCard\web.config). Never put real passwords
  back into this file in git.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath=".\DBPBusinessCardEditable.exe" arguments="" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess">
        <environmentVariables>
          <!-- UAT / test server (turns off developer error pages and Swagger) -->
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Staging" />
          <!-- Card database. Replace CHANGE_ME with the app login the DBA created (not 'sa'). -->
          <environmentVariable name="ConnectionStrings__CardsDb" value="Server=172.16.64.20,1433;Database=DBP_eCard;User ID=CHANGE_ME;Password=CHANGE_ME;TrustServerCertificate=True;Application Name=DBP eCard" />
          <!-- Folder for published card pages. Keep it OUTSIDE the app folder so a redeploy does not delete it. -->
          <environmentVariable name="Publishing__OutputPath" value="C:\inetpub\eCard_published\" />
          <!-- Address of this site + /published  (change if the site uses a name or another port) -->
          <environmentVariable name="Publishing__PublicBaseUrl" value="http://172.16.64.19/published" />
          <!-- Admin console password. Leave empty to keep the admin console switched off. -->
          <environmentVariable name="ADMIN_KEY" value="" />
        </environmentVariables>
      </aspNetCore>
    </system.webServer>
  </location>
</configuration>
