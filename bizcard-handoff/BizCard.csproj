<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>BizCard</RootNamespace>
    <UserSecretsId>bizcard-dev-secrets</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Windows Integrated Auth (Kerberos, with NTLM fallback) -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Negotiate" Version="8.0.0" />
    <!-- Raw LDAP client used for the read-only service-account bind -->
    <PackageReference Include="System.DirectoryServices.Protocols" Version="8.0.0" />
  </ItemGroup>

</Project>
